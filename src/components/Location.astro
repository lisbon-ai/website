<!-- Location -->
<section class="border-t border-white/10">
    <div class="mx-auto max-w-[90rem] px-6 py-20">
        <div class="grid md:grid-cols-2 gap-12">
            <div>
                <div class="small-headline mb-4">/location</div>
                <div
                    class="font-display text-5xl md:text-7xl font-bold uppercase tracking-tight mb-8"
                >
                    Centro Champalimaud For the Unknown. Belém, Lisbon.
                </div>
                <p>
                    A riverfront research center campus in Belém with bright
                    interiors, clean lines and space for technical conversations
                    to spill outside. Easy to reach from central Lisbon by
                    train, taxi bus or rideshare.
                </p>
            </div>
            <div class="md:pl-8" data-venue-grid data-base={import.meta.env.BASE_URL}>
                <div>
                    <img data-venue-main alt="" class="w-full rounded-lg" />
                </div>
                <div class="grid grid-cols-3 gap-4 mt-4">
                    <img data-venue-thumb alt="" class="aspect-[4/3] w-full rounded-lg object-cover" />
                    <img data-venue-thumb alt="" class="aspect-[4/3] w-full rounded-lg object-cover" />
                    <img data-venue-thumb alt="" class="aspect-[4/3] w-full rounded-lg object-cover" />
                </div>
            </div>
        </div>
    </div>
</section>

<script is:inline>
    (() => {
        const grid = document.querySelector("[data-venue-grid]");
        if (!grid) return;
        const base = grid.dataset.base;
        const photos = [
            {
                file: "1.jpg",
                alt: "Aerial view of Centro Champalimaud and its riverside amphitheatre",
            },
            {
                file: "2.jpg",
                alt: "Outdoor amphitheatre at Centro Champalimaud overlooking the Tagus River",
            },
            {
                file: "3.jpg",
                alt: "Oval opening and shaded terrace in Centro Champalimaud’s stone façade",
            },
            {
                file: "4.jpg",
                alt: "Auditorium at Centro Champalimaud overlooking the Tagus through an oval window",
            },
        ].sort(() => Math.random() - 0.5);
        const setPhoto = (img, photo) => {
            img.src = `${base}images/venue/${photo.file}`;
            img.alt = photo.alt;
        };
        setPhoto(grid.querySelector("[data-venue-main]"), photos[0]);
        grid.querySelectorAll("[data-venue-thumb]").forEach((img, i) => {
            setPhoto(img, photos[i + 1]);
        });
    })();
</script>
