---
const release = `${import.meta.env.BASE_URL}motifs/1.2.0/`;
---
<div
  data-motifs
  data-motifs-release={release}
  class="pointer-events-none absolute top-0 left-0 right-0 h-1/2 overflow-hidden md:inset-y-0 md:h-auto md:left-auto md:w-[70%]"
>
  <script is:inline>
    if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
      document.currentScript.parentElement.dataset.renderer = "loading";
    }
  </script>
  <img
    data-motifs-poster
    src={`${release}poster.webp`}
    width="1200" height="1200" alt="" fetchpriority="high"
    class="h-[200%] w-full object-cover object-center md:h-full"
  />
  <canvas
    data-motifs-canvas hidden aria-hidden="true"
    class="h-[200%] w-full object-cover object-center md:h-full"
  ></canvas>
</div>
<script is:inline type="module">
  const root = document.querySelector("[data-motifs]");
  const release = new URL(root.dataset.motifsRelease, location.href);
  import(new URL("motifs.js", release).href)
    .then(({ mountMotifs }) => mountMotifs(root))
    .catch(() => {
      root.dataset.renderer = "fallback";
      root.querySelector("[data-motifs-poster]").hidden = false;
    });
</script>
<style>
  @media (prefers-reduced-motion: no-preference) {
    [data-renderer="loading"] [data-motifs-poster] { visibility: hidden; }
  }
  [hidden] { display: none !important; }
</style>
