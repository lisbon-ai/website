---
const release = `${import.meta.env.BASE_URL}motifs/1.1.0/`;
---
<div
  data-motifs
  data-motifs-release={release}
  class="pointer-events-none absolute top-0 left-0 right-0 h-1/2 overflow-hidden md:inset-y-0 md:h-auto md:left-auto md:w-4/5"
>
  <img
    data-motifs-poster
    src={`${release}poster.webp`}
    width="1200" height="1200" alt="" fetchpriority="high"
    class="h-[200%] w-full object-cover object-top md:h-full"
  />
  <canvas
    data-motifs-canvas hidden aria-hidden="true"
    class="h-[200%] w-full object-cover object-top md:h-full"
  ></canvas>
  <button
    data-motifs-toggle hidden type="button"
    class="pointer-events-auto absolute top-4 right-6 z-10 min-h-11 border border-white/20 bg-ink/95 px-3 font-mono text-[10px] text-soft hover:text-cream focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent md:top-auto md:right-8 md:bottom-6"
  >Play animation</button>
</div>
<script is:inline type="module">
  const root = document.querySelector("[data-motifs]");
  const release = new URL(root.dataset.motifsRelease, location.href);
  import(new URL("motifs.js", release).href)
    .then(({ mountMotifs }) => mountMotifs(root))
    .catch(() => { root.dataset.renderer = "fallback"; });
</script>
<style>
  [hidden] { display: none !important; }
</style>
