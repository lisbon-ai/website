---
interface Props {
  // Fills the whole parent instead of the homepage's top-half/right-70% box.
  // The lobby display (/tv) runs the animation edge to edge behind the
  // programme; the same poster and canvas box keep the renderer's contract.
  fill?: boolean;
}

const { fill = false } = Astro.props;
const release = `${import.meta.env.BASE_URL}motifs/1.3.0/`;
const hostClass = fill
  ? "pointer-events-none absolute inset-0 overflow-hidden"
  : "pointer-events-none absolute top-0 left-0 right-0 h-1/2 overflow-hidden md:inset-y-0 md:h-auto md:left-auto md:w-[70%]";
const mediaClass = fill
  ? "h-full w-full object-cover object-center"
  : "h-[200%] w-full object-cover object-center md:h-full";
---
<div
  data-motifs
  data-motifs-release={release}
  class={hostClass}
>
  <script is:inline>
    if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
      document.currentScript.parentElement.dataset.renderer = "loading";
    }
  </script>
  <img
    data-motifs-poster
    src={`${release}poster.webp`}
    width="1200" height="1200" alt="" fetchpriority="high"
    class={mediaClass}
  />
  <canvas
    data-motifs-canvas hidden aria-hidden="true"
    class={mediaClass}
  ></canvas>
</div>
<script is:inline type="module">
  const root = document.querySelector("[data-motifs]");
  const release = new URL(root.dataset.motifsRelease, location.href);
  import(new URL("motifs.js", release).href)
    .then(({ mountMotifs }) => mountMotifs(root))
    .catch(() => {
      root.dataset.renderer = "fallback";
      root.querySelector("[data-motifs-poster]").hidden = false;
    });
</script>
<style>
  @media (prefers-reduced-motion: no-preference) {
    [data-renderer="loading"] [data-motifs-poster] { visibility: hidden; }
  }
  [hidden] { display: none !important; }
</style>
