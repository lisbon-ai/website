---
import { speakers as siteSpeakers } from "../data/speakers";

// Slots and topics list speaker names; org, talk title and profile link are all
// resolved from the speakers list so there is one place to edit them.
const speakerByName = new Map(
  siteSpeakers.map((speaker) => [speaker.name, speaker]),
);

interface Props {
  name: string;
}

const { name } = Astro.props;
const speaker = speakerByName.get(name);
---

<li>
  {speaker?.talk && (
    <div class="text-base leading-snug text-cream/90">{speaker.talk}</div>
  )}
  <div
    class={speaker?.talk
      ? "mt-1 text-sm text-muted"
      : "text-base text-cream/90"}
  >
    {speaker?.profileUrl ? (
      <a
        href={speaker.profileUrl}
        class="hover:text-cream focus-visible:text-cream focus-visible:outline-1 focus-visible:outline-offset-2 focus-visible:outline-white/50"
      >
        {name}
      </a>
    ) : (
      name
    )}
    {speaker?.org && (
      <span class={speaker.talk ? "text-faint" : "text-muted"}>
        {" · "}
        {speaker.orgUrl ? (
          <a
            href={speaker.orgUrl}
            class="hover:text-cream focus-visible:text-cream focus-visible:outline-1 focus-visible:outline-offset-2 focus-visible:outline-white/50"
          >
            {speaker.org}
          </a>
        ) : (
          speaker.org
        )}
      </span>
    )}
  </div>
</li>
