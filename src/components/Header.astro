---
const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname.replace(/\/$/, "");
const isActive = (href: string) => path === href.replace(/\/$/, "");

const navLinks = [
  { href: `${base}about/`, label: "About" },
  { href: `${base}speakers/`, label: "Speakers" },
  { href: `${base}conduct/`, label: "Conduct" },
];
---

<header
  class="sticky top-0 z-50 flex items-center justify-between border-b border-white/10 bg-ink/90 px-8 py-5 backdrop-blur"
>
  <a
    href={import.meta.env.BASE_URL}
    class="flex items-center gap-2 font-mono text-xs uppercase"
  >
    <span class="braille-spinner inline-block text-muted" aria-hidden="true"
      >⣾</span
    >
    Lisbon AI
    <span class="text-muted">/2026</span>
  </a>
  <nav class="flex items-center gap-6 text-sm">
    {
      navLinks.map(({ href, label }) => (
        <a href={href} class:list={{ "text-white": isActive(href) }}>
          {label}
        </a>
      ))
    }
    <a href="https://tickets.lisbonai.org/lisbonai-2026">Tickets</a>
  </nav>
</header>

<script>
  const frames = ["⣷", "⣯", "⣟", "⡿", "⢿", "⣻", "⣽", "⣾"];
  const el = document.querySelector<HTMLElement>(".braille-spinner");
  if (el) {
    let i = 0;
    setInterval(() => {
      i = (i + 1) % frames.length;
      el.textContent = frames[i];
    }, 120);
  }
</script>
