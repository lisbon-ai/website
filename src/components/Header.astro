---
const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname.replace(/\/$/, "");
const isActive = (href: string) => path === href.replace(/\/$/, "");

const navLinks = [
  { href: `${base}about/`, label: "About" },
  { href: `${base}speakers/`, label: "Speakers" },
  { href: `${base}conduct/`, label: "Conduct" },
  { href: "https://tickets.lisbonai.org/lisbonai-2026", label: "Tickets" },
];
---

<header
  class="sticky top-0 z-50 flex items-center justify-between border-b border-white/10 bg-ink/90 px-8 py-5 backdrop-blur"
>
  <a
    href={import.meta.env.BASE_URL}
    class="flex items-center gap-2 font-mono text-xs uppercase"
  >
    <span class="braille-spinner inline-block text-muted" aria-hidden="true"
      >⣾</span
    >
    Lisbon AI
    <span class="text-muted">/2026</span>
  </a>

  <!-- Desktop nav -->
  <nav class="hidden items-center gap-6 text-sm md:flex">
    {
      navLinks.map(({ href, label }) => (
        <a href={href} class:list={{ "text-white": isActive(href) }}>
          {label}
        </a>
      ))
    }
  </nav>

  <!-- Mobile toggle -->
  <button
    id="menu-toggle"
    type="button"
    data-open="false"
    aria-label="Open menu"
    aria-expanded="false"
    aria-controls="mobile-menu"
    class="group -mr-2 flex h-10 w-10 items-center justify-center md:hidden"
  >
    <span class="relative flex h-5 w-6 items-center justify-center">
      <span
        class="absolute h-px w-6 origin-center bg-current transition-transform duration-300 ease-out -translate-y-[6px] group-data-[open=true]:translate-y-0 group-data-[open=true]:rotate-45"
      ></span>
      <span
        class="absolute h-px w-6 bg-current transition-opacity duration-200 group-data-[open=true]:opacity-0"
      ></span>
      <span
        class="absolute h-px w-6 origin-center bg-current transition-transform duration-300 ease-out translate-y-[6px] group-data-[open=true]:translate-y-0 group-data-[open=true]:-rotate-45"
      ></span>
    </span>
  </button>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    data-open="false"
    class="absolute inset-x-0 top-full grid grid-rows-[0fr] border-b border-white/10 bg-ink/95 backdrop-blur transition-[grid-template-rows] duration-300 ease-out data-[open=true]:grid-rows-[1fr] md:hidden"
  >
    <div class="overflow-hidden">
      <nav class="flex flex-col gap-5 px-8 pb-6 pt-2 text-sm">
        {
          navLinks.map(({ href, label }) => (
            <a href={href} class:list={{ "text-white": isActive(href) }}>
              {label}
            </a>
          ))
        }
      </nav>
    </div>
  </div>
</header>

<script>
  const frames = ["⣷", "⣯", "⣟", "⡿", "⢿", "⣻", "⣽", "⣾"];
  const el = document.querySelector<HTMLElement>(".braille-spinner");
  if (el) {
    let i = 0;
    setInterval(() => {
      i = (i + 1) % frames.length;
      el.textContent = frames[i];
    }, 120);
  }

  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  if (toggle && menu) {
    const setOpen = (open: boolean) => {
      const value = String(open);
      toggle.dataset.open = value;
      menu.dataset.open = value;
      toggle.setAttribute("aria-expanded", value);
      toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    };

    toggle.addEventListener("click", () => {
      setOpen(toggle.dataset.open !== "true");
    });

    // Close when a menu link is tapped
    menu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => setOpen(false));
    });
  }
</script>
