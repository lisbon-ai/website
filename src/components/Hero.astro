---
import { speakers } from "../data/speakers";
import { sponsorTiers } from "../data/sponsors";

// Hero strip runs platinum → gold → silver; community sits this one out.
const heroSponsors = ["Platinum", "Gold", "Silver"].flatMap((label) =>
  (sponsorTiers.find((tier) => tier.label === label)?.sponsors ?? []).map(
    (sponsor) => ({ ...sponsor, tier: label }),
  ),
);

// Hero-only size overrides, so the sponsors grid keeps its own sizing.
const heroLogoClass: Record<string, string> = {
  Cloudflare: "h-5",
  Supabase: "h-5",
};

// Optical nudges — the AWS mark is stacked rather than a flat wordmark, so it
// reads high against the row of wordmarks. Keyed by sponsor name.
const heroNudge: Record<string, string> = {
  AWS: "translate-y-[5px]",
};

---

<!-- Hero -->
<section class="relative min-h-[90vh] overflow-hidden">
  <div
    class="pointer-events-none absolute top-0 left-0 right-0 h-1/2 overflow-hidden md:inset-y-0 md:h-auto md:left-auto md:w-4/5"
  >
    <video
      class="h-[200%] w-full object-cover object-top md:h-full"
      autoplay
      loop
      muted
      playsinline
      preload="auto"
    >
      <source
        src={`${import.meta.env.BASE_URL}hero-h265.mp4`}
        type='video/mp4; codecs="hvc1"'
      />
      <source
        src={`${import.meta.env.BASE_URL}hero-vp9.webm`}
        type='video/webm; codecs="vp9"'
      />
      <source
        src={`${import.meta.env.BASE_URL}hero-av1.webm`}
        type='video/webm; codecs="av01.0.08M.08"'
      />
      <source
        src={`${import.meta.env.BASE_URL}hero.mp4`}
        type='video/mp4; codecs="avc1.640033"'
      />
    </video>
  </div>

  <div
    class="relative mx-auto flex min-h-[90vh] flex-col justify-end px-6 md:px-8 pb-[52px] md:pb-24 pt-16 md:pt-28"
  >
    <!--
        <div>
            <a
                href="https://x.com/lisbonai_"
                class="text-[11px] uppercase font-mono mb-8 bg-white/10 px-2.5 py-1.5 rounded-sm inline-block"
            >
                We're on X &rarr;
            </a>
        </div>
        -->

    <h1 class="big-headline">LISBON AI</h1>
    <div class="mt-8 mb-8 max-w-xl text-xl leading-snug text-muted md:mb-10">
      2 days. {speakers.length} speakers. 400 builders.<br />
      No other place to be. Sep 23–24.
    </div>
    <div>
      <a href="https://tickets.lisbonai.org/lisbonai-2026" class="tickets-cta">
        Get your ticket &rarr;
      </a>
    </div>

    <!-- Speakers strip — swapped for the sponsors strip below.
    <div
      class="mt-12 flex max-w-full items-center gap-x-5 overflow-hidden whitespace-nowrap [text-shadow:0_1px_8px_rgb(4_4_41_/_1)] md:mt-14 md:gap-x-7"
      aria-label="Speaker companies"
    >
      <span class="shrink-0 font-mono text-xs leading-none text-muted">
        Speakers from
      </span>
      <a
        href="https://zed.dev"
        class="hidden shrink-0 items-center min-[360px]:inline-flex"
        aria-label="Zed Industries"
      >
        <img
          src={`${import.meta.env.BASE_URL}images/logos/zed.svg`}
          alt="Zed"
          class="block h-4 w-auto drop-shadow-[0_1px_8px_rgb(4_4_41_/_1)]"
        />
      </a>
      <a
        href="https://cloudflare.com"
        class="hidden shrink-0 items-center min-[520px]:inline-flex"
        aria-label="Cloudflare"
      >
        <img
          src={`${import.meta.env.BASE_URL}images/logos/cloudflare.svg`}
          alt="Cloudflare"
          class="block h-4 w-auto -translate-y-[2px] drop-shadow-[0_1px_8px_rgb(4_4_41_/_1)]"
        />
      </a>
      <a
        href="https://huggingface.co"
        class="hidden shrink-0 items-center min-[760px]:inline-flex"
        aria-label="Hugging Face"
      >
        <img
          src={`${import.meta.env.BASE_URL}images/logos/huggingface.svg`}
          alt="Hugging Face"
          class="block h-7 w-auto drop-shadow-[0_1px_8px_rgb(4_4_41_/_1)]"
        />
      </a>
      <a
        href="#speakers"
        class="shrink-0 font-mono text-xs leading-none text-muted transition hover:text-cream"
      >
        + and more
      </a>
    </div>
    -->

    <div
      class="mt-12 flex max-w-full items-center gap-x-5 overflow-hidden whitespace-nowrap [text-shadow:0_1px_8px_rgb(4_4_41_/_1)] md:mt-14 md:gap-x-7"
      aria-label="Sponsors"
      data-sponsor-strip
    >
      <span class="shrink-0 font-mono text-xs leading-none text-muted">
        Sponsored by
      </span>
      <div
        data-sponsor-logos
        class="flex h-10 min-w-0 shrink flex-wrap content-start items-center gap-x-5 overflow-hidden md:gap-x-7"
      >
        {
        heroSponsors.map(({ name, url, logo, logoClass, tier }) => (
          <a
            href={url}
            data-tier={tier}
            class="inline-flex h-10 shrink-0 items-center"
            aria-label={name}
          >
            {/* The speaker logos this strip replaced were drawn in the muted
                token. Sponsor logos come in their own colours, so the <img>
                only sizes the box while a masked overlay paints the mark. */}
            <span
              class:list={[
                "relative inline-block drop-shadow-[0_1px_8px_rgb(4_4_41_/_1)]",
                heroNudge[name],
              ]}
            >
              <img
                src={`${import.meta.env.BASE_URL}images/sponsors/${logo}`}
                alt={name}
                class:list={[
                  "block w-auto opacity-0",
                  heroLogoClass[name] ?? logoClass ?? "h-4",
                ]}
              />
              <span
                aria-hidden="true"
                class="absolute inset-0 bg-muted"
                style={`-webkit-mask:url(${import.meta.env.BASE_URL}images/sponsors/${logo}) center/contain no-repeat;mask:url(${import.meta.env.BASE_URL}images/sponsors/${logo}) center/contain no-repeat`}
              />
            </span>
          </a>
        ))
        }
      </div>
      <a
        href="#sponsors"
        data-sponsor-more
        class="shrink-0 font-mono text-xs leading-none text-muted transition hover:text-cream"
      >
        + and more
      </a>
    </div>
  </div>
</section>

<script>
  // The wrap-and-clip CSS hides logos that don't fit, but the track still
  // occupies the leftover width, stranding "+ and more" far to the right.
  // Drop the ones that don't fit and let the track hug what's left.
  const strip = document.querySelector<HTMLElement>("[data-sponsor-strip]");
  const track = strip?.querySelector<HTMLElement>("[data-sponsor-logos]");
  const more = strip?.querySelector<HTMLElement>("[data-sponsor-more]");

  if (strip && track && more) {
    const label = strip.firstElementChild as HTMLElement;
    const logosInOrder = () => Array.from(track.children) as HTMLElement[];
    const gapOf = (el: HTMLElement) =>
      parseFloat(getComputedStyle(el).columnGap) || 0;

    const fit = () => {
      // Measure from a clean slate — hidden elements report zero width.
      track.style.display = "";
      track.style.flex = "";
      const logos = logosInOrder();
      logos.forEach((logo) => (logo.style.display = ""));

      const outerGap = gapOf(strip);
      const innerGap = gapOf(track);
      const available =
        strip.clientWidth - label.offsetWidth - more.offsetWidth - outerGap * 2;

      // Stop at the first logo that doesn't fit — carrying on would show a
      // narrow gold logo while the platinum one ahead of it stayed hidden.
      let used = 0;
      let dropping = false;
      logos.forEach((logo) => {
        const width = logo.offsetWidth + (used > 0 ? innerGap : 0);
        if (!dropping && used + width <= available) {
          used += width;
        } else {
          dropping = true;
          logo.style.display = "none";
        }
      });

      // Hug the survivors so the link sits right beside the last logo.
      track.style.flex = "0 0 auto";
      track.style.display = used > 0 ? "" : "none";
    };

    // No sponsor should always be the one that gets truncated away, so the
    // order within a tier is reshuffled on every load. Platinum stays put —
    // it's a single sponsor and leads by rank.
    const shuffleTier = (tier: string) => {
      const group = Array.from(
        track.querySelectorAll<HTMLElement>(`[data-tier="${tier}"]`),
      );
      if (group.length < 2) return;
      const after = group[group.length - 1].nextSibling;
      for (let i = group.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [group[i], group[j]] = [group[j], group[i]];
      }
      group.forEach((logo) => track.insertBefore(logo, after));
    };

    shuffleTier("Gold");
    shuffleTier("Silver");

    fit();
    addEventListener("resize", fit);
    // Font swaps change the label and link widths.
    document.fonts?.ready.then(fit);
  }
</script>
