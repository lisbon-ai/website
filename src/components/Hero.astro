<!-- Hero -->
<section class="relative min-h-[90vh] overflow-hidden">
  <div
    class="pointer-events-none absolute top-0 left-0 right-0 h-1/2 overflow-hidden md:inset-y-0 md:h-auto md:left-auto md:w-4/5"
  >
    <video
      class="h-[200%] w-full object-cover object-top md:h-full"
      autoplay
      loop
      muted
      playsinline
      preload="auto"
    >
      <source
        src={`${import.meta.env.BASE_URL}hero-h265.mp4`}
        type='video/mp4; codecs="hvc1"'
      />
      <source
        src={`${import.meta.env.BASE_URL}hero-vp9.webm`}
        type='video/webm; codecs="vp9"'
      />
      <source
        src={`${import.meta.env.BASE_URL}hero-av1.webm`}
        type='video/webm; codecs="av01.0.08M.08"'
      />
      <source
        src={`${import.meta.env.BASE_URL}hero.mp4`}
        type='video/mp4; codecs="avc1.640033"'
      />
    </video>
  </div>

  <div
    class="relative mx-auto flex min-h-[90vh] flex-col justify-end px-6 md:px-8 pb-[52px] md:pb-24 pt-16 md:pt-28"
  >
    <!--
        <div>
            <a
                href="https://x.com/lisbonai_"
                class="text-[11px] uppercase font-mono mb-8 bg-white/10 px-2.5 py-1.5 rounded-sm inline-block"
            >
                We're on X &rarr;
            </a>
        </div>
        -->

    <h1 class="big-headline">LISBON AI</h1>
    <div class="mt-8 mb-8 max-w-xl text-xl leading-snug text-muted md:mb-10">
      2 days. 400 builders.<br />
      Join us September 23-24.
    </div>
    <div>
      <a href="https://tickets.lisbonai.org/lisbonai-2026" class="tickets-cta">
        Get your ticket &rarr;
      </a>
    </div>

    <div
      class="mt-12 flex max-w-full items-center gap-x-5 overflow-hidden whitespace-nowrap [text-shadow:0_1px_8px_rgb(4_4_41_/_1)] md:mt-14 md:gap-x-7"
      aria-label="Speaker companies"
    >
      <span class="shrink-0 font-mono text-xs leading-none text-muted">
        Speakers from
      </span>
      <a
        href="https://zed.dev"
        class="hidden shrink-0 items-center min-[360px]:inline-flex"
        aria-label="Zed Industries"
      >
        <img
          src={`${import.meta.env.BASE_URL}images/logos/zed.svg`}
          alt="Zed"
          class="block h-4 w-auto drop-shadow-[0_1px_8px_rgb(4_4_41_/_1)]"
        />
      </a>
      <a
        href="https://cloudflare.com"
        class="hidden shrink-0 items-center min-[520px]:inline-flex"
        aria-label="Cloudflare"
      >
        <img
          src={`${import.meta.env.BASE_URL}images/logos/cloudflare.svg`}
          alt="Cloudflare"
          class="block h-4 w-auto -translate-y-[2px] drop-shadow-[0_1px_8px_rgb(4_4_41_/_1)]"
        />
      </a>
      <a
        href="https://huggingface.co"
        class="hidden shrink-0 items-center min-[760px]:inline-flex"
        aria-label="Hugging Face"
      >
        <img
          src={`${import.meta.env.BASE_URL}images/logos/huggingface.svg`}
          alt="Hugging Face"
          class="block h-7 w-auto drop-shadow-[0_1px_8px_rgb(4_4_41_/_1)]"
        />
      </a>
      <a
        href="#speakers"
        class="shrink-0 font-mono text-xs leading-none text-muted transition hover:text-cream"
      >
        + and more
      </a>
    </div>
  </div>
</section>
