---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Location from "../components/Location.astro";
import {
    aboutPhotos,
    type AboutPhotoKind,
    type AboutPhotoOrientation,
} from "../data/aboutPhotos";

type AboutPhotoSlot = {
    name: "hero" | "portrait" | "secondary" | "detail";
    orientation: AboutPhotoOrientation;
    frameClass: string;
    kinds?: AboutPhotoKind[];
    loading?: "lazy";
    fetchPriority?: "high";
};

const aboutPhotoImageClass =
    "h-full w-full object-cover transition-opacity duration-500 motion-reduce:transition-none";

const aboutPhotoSlotDefinitions: AboutPhotoSlot[] = [
    {
        name: "hero",
        orientation: "horizontal",
        kinds: ["context"],
        frameClass:
            "aspect-[3/2] overflow-hidden rounded-2xl bg-white/[0.03] md:col-span-7",
        fetchPriority: "high",
    },
    {
        name: "portrait",
        orientation: "vertical",
        frameClass:
            "aspect-[4/5] max-h-[70vh] overflow-hidden rounded-2xl bg-white/[0.03] md:col-span-5 md:row-span-2 md:h-full md:max-h-none md:aspect-auto",
    },
    {
        name: "secondary",
        orientation: "horizontal",
        kinds: ["talk"],
        frameClass:
            "aspect-[3/2] overflow-hidden rounded-2xl bg-white/[0.03] md:col-span-4",
        loading: "lazy",
    },
    {
        name: "detail",
        orientation: "horizontal",
        kinds: ["community", "detail"],
        frameClass:
            "aspect-[3/2] overflow-hidden rounded-2xl bg-white/[0.03] md:col-span-3 md:h-full md:aspect-auto",
        loading: "lazy",
    },
];

const withBaseUrl = (photo: (typeof aboutPhotos)[number]) => ({
    ...photo,
    src: `${import.meta.env.BASE_URL}${photo.src}`,
});

const aboutPhotoPool = aboutPhotos.map(withBaseUrl);

const matchesPhotoSlot = (
    photo: (typeof aboutPhotoPool)[number],
    slot: AboutPhotoSlot,
) =>
    photo.orientation === slot.orientation &&
    (!slot.kinds || slot.kinds.includes(photo.kind));

const photoSlots = aboutPhotoSlotDefinitions.map((slot) => {
    const primaryPhotos = aboutPhotoPool.filter((photo) =>
        matchesPhotoSlot(photo, slot),
    );
    const orientationPhotos = aboutPhotoPool.filter(
        (photo) => photo.orientation === slot.orientation,
    );

    return {
        ...slot,
        primaryPhotos,
        orientationPhotos,
        fallbackPhoto: primaryPhotos[0] ?? orientationPhotos[0] ?? aboutPhotoPool[0],
    };
});
---

<Layout>
    <Header />

    <!-- Photos -->
    <section class="border-t border-white/10">
        <div class="mx-auto max-w-6xl py-16 px-8 md:px-0">
            <div class="small-headline mb-4">/know-more</div>
            <h1 class="text-2xl mb-8">About Lisbon AI</h1>

            <div class="grid gap-6 md:grid-cols-12 md:gap-8">
                {
                    photoSlots.map((slot) => (
                        <figure
                            data-about-photo-slot={slot.name}
                            class={slot.frameClass}
                        >
                            <noscript>
                                <img
                                    src={slot.fallbackPhoto.src}
                                    alt={slot.fallbackPhoto.alt}
                                    class={aboutPhotoImageClass}
                                    style={`object-position: ${slot.fallbackPhoto.position}`}
                                    decoding="async"
                                    loading={slot.loading}
                                    fetchpriority={slot.fetchPriority}
                                />
                            </noscript>
                        </figure>
                    ))
                }
            </div>

            <script define:vars={{ aboutPhotoImageClass, photoSlots }}>
                const selectedSources = new Set();

                const availablePhotos = (photos) =>
                    photos.filter((photo) => !selectedSources.has(photo.src));

                const randomPhoto = (slot) => {
                    const candidates = availablePhotos(slot.primaryPhotos);
                    const fallbackCandidates = availablePhotos(
                        slot.orientationPhotos,
                    );
                    const pool =
                        candidates.length > 0 ? candidates : fallbackCandidates;

                    if (pool.length === 0) return null;

                    const photo = pool[Math.floor(Math.random() * pool.length)];
                    selectedSources.add(photo.src);
                    return photo;
                };

                const createImage = (photo, slot) => {
                    const image = document.createElement("img");

                    image.className = `${aboutPhotoImageClass} opacity-0`;
                    image.alt = photo.alt;
                    image.decoding = "async";
                    image.style.objectPosition = photo.position;

                    if (slot.fetchPriority) {
                        image.setAttribute("fetchpriority", slot.fetchPriority);
                    }

                    if (slot.loading) {
                        image.loading = slot.loading;
                    }

                    image.addEventListener(
                        "load",
                        () => image.classList.remove("opacity-0"),
                        { once: true },
                    );
                    image.src = photo.src;

                    if (image.complete) {
                        image.classList.remove("opacity-0");
                    }

                    return image;
                };

                for (const slot of photoSlots) {
                    const photo = randomPhoto(slot);
                    const frame = document.querySelector(
                        `[data-about-photo-slot="${slot.name}"]`,
                    );

                    if (!photo || !frame) continue;

                    frame.append(createImage(photo, slot));
                }
            </script>
        </div>
    </section>

    <section class="border-t border-white/10">
        <div class="mx-auto max-w-6xl py-16 px-8 md:px-0">
            <div class="grid md:grid-cols-2 gap-8">
                <div>
                    <div class="small-headline mb-4">/what-to-expect</div>
                    <p class="text-xl mb-8">
                        Lisbon AI started as a not‑so‑quiet group chat of
                        hackers reminiscing about LXJS and wondering why there
                        wasn’t a European, builder‑first AI gathering. We fixed
                        that in 2025, and we're back for more in 2026.
                    </p>
                </div>
                <div class="md:px-12">
                    <ul class="text-xl">
                        <li class="mb-4">
                            Community-run<br />
                            <span class="text-muted"
                                >Organized by people who ship open-source for a
                                living. Volunteer based.</span
                            >
                        </li>
                        <li class="mb-4 border-t border-white/10 pt-4">
                            Single‑track talks, multi‑track fun<br />
                            <span class="text-muted"
                                >You never miss a talk, but you choose your own
                                dinners, workshops, and hackathon projects.</span
                            >
                        </li>
                        <li class="mb-4 border-t border-white/10 pt-4">
                            Open-source<br />
                            <span class="text-muted"
                                >Every speaker presents the code. Every talk is
                                live-streamed.</span
                            >
                        </li>
                        <li class="mb-4 border-t border-white/10 pt-4">
                            Ethical by design<br />
                            <span class="text-muted"
                                >Code of conduct, diverse curation, and
                                scholarships baked in</span
                            >
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </section>

    <Location />

    <Footer />
</Layout>
