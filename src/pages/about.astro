---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
---

<Layout>
    <Header />

    <section class="border-t border-white/10">
        <div class="mx-auto max-w-6xl py-16">
            <div class="small-headline mb-4">[Know more]</div>
            <h1 class="text-2xl mb-8">About Lisbon AI</h1>

            <div class="grid grid-cols-2 gap-8">
                <img
                    src="/images/event-anomaly.webp"
                    class="w-full h-auto rounded-2xl"
                />
                <img
                    src="/images/event-audience.webp"
                    class="w-full h-auto rounded-2xl"
                />
                <img
                    src="/images/event-group.webp"
                    class="w-full h-auto rounded-2xl"
                />
                <img
                    src="/images/event-speaker.webp"
                    class="w-full h-auto rounded-2xl"
                />
            </div>
        </div>
    </section>
</Layout>
