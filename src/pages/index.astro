---
import Layout from "../layouts/Layout.astro";

const speakers = [
    { name: "Malte Ubl", role: "CTO", org: "Vercel", topic: "Platforms" },
    {
        name: "Elliot Norrevik",
        role: "Growth & Eng",
        org: "Lovable",
        topic: "Platforms",
    },
    {
        name: "Sarah Wooders",
        role: "Co-founder & CTO",
        org: "Letta",
        topic: "Tooling",
    },
    { name: "Dana Lawson", role: "CTO", org: "Netlify", topic: "Tooling" },
    {
        name: "Ville Kuosmanen",
        role: "Founder",
        org: "Voyage Robotics",
        topic: "Physical AI",
    },
    {
        name: "Dana Aubakirova",
        role: "ML Research Engineer",
        org: "Hugging Face",
        topic: "Foundational Models",
    },
    { name: "Steve Ruiz", role: "Founder", org: "TLDraw", topic: "Tooling" },
    { name: "David Gomes", role: "Engineer", org: "Cursor", topic: "Tooling" },
    {
        name: "Angelo Giacco",
        role: "AI Eng & Growth",
        org: "ElevenLabs",
        topic: "Foundational Models",
    },
    {
        name: "Shadi Elaridi",
        role: "Founder & CEO",
        org: "Swish Robotics",
        topic: "Physical AI",
    },
    {
        name: "Noah Solomon",
        role: "Product Engineer",
        org: "Fal",
        topic: "Platforms",
    },
    {
        name: "Rachel-Lee Nabors",
        role: "Independent",
        org: "",
        topic: "Ethics",
    },
    {
        name: "Julia Neagu",
        role: "Co-founder & CEO",
        org: "Quotient AI",
        topic: "Platforms",
    },
    {
        name: "Joe Rowell",
        role: "Founding Engineer",
        org: "Poolside",
        topic: "Foundational Models",
    },
    {
        name: "Clara Matos",
        role: "Director of Applied AI",
        org: "Sword Health",
        topic: "Ethics",
    },
    {
        name: "Jaime Jorge",
        role: "Founder, CEO",
        org: "Codacy",
        topic: "Tooling",
    },
    {
        name: "André Baptista",
        role: "Founder, CTO",
        org: "Ethiack",
        topic: "Ethics",
    },
    {
        name: "Pedro Coelho",
        role: "Senior Director of AI/ML",
        org: "Zendesk",
        topic: "Ethics",
    },
    {
        name: "Nikita Khomich",
        role: "Founding Member",
        org: "Tzafon",
        topic: "Foundational Models",
    },
    {
        name: "Luis Clara Gomes",
        role: "Musician",
        org: "Moullinex",
        topic: "Ethics",
    },
];

const format = [
    "Talks",
    "Interviews",
    "Lightning Talks",
    "Demos",
    "Chill Area",
    "Riverside Lunch",
    "Sunset Party",
];

const faqs = [
    {
        q: "What are the dates of the conference?",
        a: "Lisbon AI 2026 takes place September 23–24, 2026.",
    },
    {
        q: "Where is the conference being held?",
        a: "In Lisbon, Portugal. Venue details will be shared with ticket holders closer to the event.",
    },
    {
        q: "Who can attend?",
        a: "Engineers, researchers, and builders shipping AI in production. Tickets are limited to ~400 attendees.",
    },
    {
        q: "Will talks be recorded?",
        a: "Yes, most talks are recorded and shared after the event.",
    },
    {
        q: "Can I volunteer?",
        a: "We'll open a volunteer application closer to the event. Join us on Discord to hear first.",
    },
    {
        q: "Who is organizing this?",
        a: "Lisbon AI is organized by a small team of engineers and operators based in Lisbon.",
    },
];
---

<Layout>
    <!-- Top nav -->
    <header
        class="mx-auto flex max-w-6xl items-center justify-between px-6 py-6"
    >
        <a
            href="/"
            class="font-mono text-sm font-medium uppercase tracking-widest"
        >
            Lisbon AI
            <span class="ml-2 text-muted">2026 Edition</span>
        </a>
        <nav class="hidden items-center gap-8 text-sm md:flex">
            <a href="#speakers" class="hover:text-muted">Speakers</a>
            <a href="#format" class="hover:text-muted">Talks</a>
            <a
                href="#tickets"
                class="rounded-full bg-cream-warm px-4 py-2 text-ink hover:bg-cream"
            >
                Get tickets &rarr;
            </a>
        </nav>
    </header>

    <!-- Hero -->
    <section class="relative min-h-[90vh] overflow-hidden">
        <video
            class="absolute inset-0 h-full w-full object-cover"
            src="/hero.mp4"
            autoplay
            loop
            muted
            playsinline
            preload="auto"></video>
        <div
            class="pointer-events-none absolute inset-0 bg-gradient-to-b from-ink/40 via-transparent to-ink"
        >
        </div>
        <div
            class="relative mx-auto flex min-h-[90vh] max-w-6xl flex-col justify-end px-6 pb-24 pt-16 md:pt-28"
        >
            <h1
                class="font-sans text-[18vw] font-black leading-[0.85] tracking-tight md:text-[14rem]"
            >
                LISBON <br class="md:hidden" />AI
            </h1>
            <div
                class="mt-10 max-w-xl text-2xl font-medium leading-snug md:text-3xl"
            >
                2 days. 400 builders.<br />
                Join September 23&ndash;24.
            </div>
        </div>
    </section>

    <!-- What to expect -->
    <section class="border-t border-white/10">
        <div class="mx-auto grid max-w-6xl gap-12 px-6 py-20 md:grid-cols-12">
            <div class="md:col-span-4">
                <div
                    class="font-mono text-xs uppercase tracking-widest text-muted"
                >
                    [ What to expect ]
                </div>
            </div>
            <div
                class="space-y-6 text-xl leading-relaxed md:col-span-8 md:text-2xl"
            >
                <p>
                    AI isn't the next big thing&mdash;it <em
                        class="not-italic font-bold">is</em
                    > the big thing.
                </p>
                <p>
                    Lisbon AI is the annual summit for people shipping AI in the
                    real world. No hype decks, no rubber-chicken dinners &mdash;
                    just code, talks, and hallway hacking.
                </p>
                <p>
                    Join top labs, founding teams, and engineers deploying
                    models in production, to chat about where we are now and
                    what's next.
                </p>
                <p class="font-mono text-base text-muted">Bring your laptop.</p>
            </div>
        </div>
    </section>

    <!-- Format -->
    <section id="format" class="border-t border-white/10">
        <div class="mx-auto grid max-w-6xl gap-12 px-6 py-20 md:grid-cols-12">
            <div class="md:col-span-4">
                <div
                    class="font-mono text-xs uppercase tracking-widest text-muted"
                >
                    [ Format ]
                </div>
            </div>
            <ul class="md:col-span-8">
                {
                    format.map((item) => (
                        <li class="flex items-baseline justify-between border-b border-white/10 py-5 text-xl md:text-2xl">
                            <span>{item}</span>
                            <span class="font-mono text-xs text-faint">
                                &rarr;
                            </span>
                        </li>
                    ))
                }
            </ul>
        </div>
    </section>

    <!-- Speakers -->
    <section id="speakers" class="border-t border-white/10">
        <div class="mx-auto max-w-6xl px-6 py-20">
            <div class="mb-12 flex items-baseline justify-between">
                <div
                    class="font-mono text-xs uppercase tracking-widest text-muted"
                >
                    [ Featured Speakers ]
                </div>
            </div>
            <div class="grid gap-px bg-white/10 md:grid-cols-2 lg:grid-cols-3">
                {
                    speakers.map((s) => (
                        <div class="flex flex-col gap-3 bg-ink p-6">
                            <div class="font-mono text-[10px] uppercase tracking-widest text-muted">
                                {s.topic}
                            </div>
                            <div class="text-xl font-medium">{s.name}</div>
                            <div class="font-mono text-xs text-muted">
                                [ {s.role}
                                {s.org && (
                                    <>
                                        , <span>{s.org}</span>
                                    </>
                                )}{" "}
                                ]
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- Stats -->
    <section class="border-t border-white/10">
        <div
            class="mx-auto grid max-w-6xl grid-cols-3 divide-x divide-white/10 px-6 py-20 text-center"
        >
            <div>
                <div class="text-5xl font-black md:text-7xl">20</div>
                <div
                    class="mt-3 font-mono text-xs uppercase tracking-widest text-muted"
                >
                    Speakers
                </div>
            </div>
            <div>
                <div class="text-5xl font-black md:text-7xl">5</div>
                <div
                    class="mt-3 font-mono text-xs uppercase tracking-widest text-muted"
                >
                    Topics
                </div>
            </div>
            <div>
                <div class="text-5xl font-black md:text-7xl">2</div>
                <div
                    class="mt-3 font-mono text-xs uppercase tracking-widest text-muted"
                >
                    Talk Days
                </div>
            </div>
        </div>
    </section>

    <!-- FAQ -->
    <section class="border-t border-white/10">
        <div class="mx-auto grid max-w-6xl gap-12 px-6 py-20 md:grid-cols-12">
            <div class="md:col-span-4">
                <div
                    class="font-mono text-xs uppercase tracking-widest text-muted"
                >
                    [ FAQ ]
                </div>
            </div>
            <div class="md:col-span-8">
                {
                    faqs.map((faq) => (
                        <details class="group border-b border-white/10 py-5">
                            <summary class="flex cursor-pointer list-none items-center justify-between text-xl md:text-2xl">
                                <span>{faq.q}</span>
                                <span class="font-mono text-xs text-faint transition group-open:rotate-45">
                                    +
                                </span>
                            </summary>
                            <p class="mt-4 max-w-2xl text-base leading-relaxed text-muted">
                                {faq.a}
                            </p>
                        </details>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- Sponsors -->
    <section class="border-t border-white/10">
        <div class="mx-auto max-w-6xl px-6 py-20">
            <div
                class="mb-12 font-mono text-xs uppercase tracking-widest text-muted"
            >
                [ Sponsors ]
            </div>
            <div class="space-y-12">
                <div>
                    <div
                        class="mb-4 font-mono text-xs uppercase tracking-widest text-muted"
                    >
                        Gold Sponsors
                    </div>
                    <div class="text-faint">Coming soon.</div>
                </div>
                <div>
                    <div
                        class="mb-4 font-mono text-xs uppercase tracking-widest text-muted"
                    >
                        Silver Sponsors
                    </div>
                    <div class="text-faint">Coming soon.</div>
                </div>
                <div>
                    <div
                        class="mb-4 font-mono text-xs uppercase tracking-widest text-muted"
                    >
                        Community Sponsors
                    </div>
                    <div class="text-faint">Coming soon.</div>
                </div>
            </div>
        </div>
    </section>

    <!-- Tickets CTA -->
    <section id="tickets" class="border-t border-white/10">
        <div class="mx-auto grid max-w-6xl gap-12 px-6 py-24 md:grid-cols-12">
            <div class="md:col-span-4">
                <div
                    class="font-mono text-xs uppercase tracking-widest text-muted"
                >
                    [ Tickets ]
                </div>
            </div>
            <div class="md:col-span-8">
                <p class="max-w-2xl text-2xl leading-snug md:text-3xl">
                    We're organizing highly curated technical sessions for
                    engineers, for researchers. Sign up to be part of this.
                </p>
                <a
                    href="#"
                    class="mt-8 inline-block rounded-full bg-cream-warm px-6 py-3 text-ink hover:bg-cream"
                >
                    Get tickets &rarr;
                </a>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="border-t border-white/10">
        <div class="mx-auto grid max-w-6xl gap-10 px-6 py-16 md:grid-cols-4">
            <div class="md:col-span-2">
                <div
                    class="font-mono text-sm font-medium uppercase tracking-widest"
                >
                    Lisbon AI
                </div>
                <p class="mt-3 max-w-xs text-sm text-muted">
                    The annual summit for people shipping AI in the real world.
                </p>
            </div>
            <div>
                <div
                    class="mb-3 font-mono text-xs uppercase tracking-widest text-muted"
                >
                    About
                </div>
                <ul class="space-y-2 text-sm">
                    <li><a href="#" class="hover:text-muted">About</a></li>
                    <li>
                        <a href="#speakers" class="hover:text-muted"
                            >Speakers</a>
                    </li>
                    <li><a href="#" class="hover:text-muted">Sponsors</a></li>
                    <li>
                        <a href="#" class="hover:text-muted">Code of Conduct</a>
                    </li>
                </ul>
            </div>
            <div>
                <div
                    class="mb-3 font-mono text-xs uppercase tracking-widest text-muted"
                >
                    Need help?
                </div>
                <ul class="space-y-2 text-sm">
                    <li>
                        <a href="#tickets" class="hover:text-muted">Tickets</a>
                    </li>
                    <li>
                        <a href="https://discord.gg/" class="hover:text-muted"
                            >Discord</a>
                    </li>
                    <li>
                        <a
                            href="https://x.com/lisbonaiconf"
                            class="hover:text-muted">X</a>
                    </li>
                    <li><a href="#" class="hover:text-muted">Privacy</a></li>
                </ul>
            </div>
        </div>
        <div
            class="mx-auto flex max-w-6xl items-center justify-between border-t border-white/10 px-6 py-6 font-mono text-xs uppercase tracking-widest text-muted"
        >
            <span>&copy; 2026 Lisbon AI</span>
            <span>Lisbon &mdash; Portugal</span>
        </div>
    </footer>
</Layout>
