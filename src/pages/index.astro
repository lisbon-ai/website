---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Footer from "../components/Footer.astro";
import Location from "../components/Location.astro";

import { format } from "../data/format";
import { faqs } from "../data/faqs";
import { trackDescriptions } from "../data/schedule";
import { cardSpeakers, logoHeight } from "../data/speakers";
import { sponsorTiers } from "../data/sponsors";

const brailleFrames = ["⣾", "⣽", "⣻", "⢿", "⡿", "⣟", "⣯", "⣷"];
const randomBraille = () =>
  brailleFrames[Math.floor(Math.random() * brailleFrames.length)];

// Vary the texture crop per card so no two cards show the same region.
const texturePositions = [
  "0% 0%",
  "100% 0%",
  "50% 20%",
  "0% 100%",
  "100% 60%",
  "25% 80%",
  "80% 100%",
];

const fullSessionSpeakers = cardSpeakers.filter(
  ({ talkType }) => talkType === "full",
);
const lightningSpeakers = cardSpeakers.filter(
  ({ talkType }) => talkType === "lightning",
);
const featuredLightning =
  lightningSpeakers[Math.floor(Math.random() * lightningSpeakers.length)];
const homepageSpeakers = [
  ...fullSessionSpeakers,
  ...(featuredLightning ? [featuredLightning] : []),
];
---

<Layout>
  <Header />
  <Hero />

  <!-- What to expect -->
  <section class="border-t border-white/10">
    <div class="mx-auto grid max-w-[90rem] gap-12 px-6 py-20 md:grid-cols-2">
      <div>
        <div class="small-headline">/what-to-expect</div>
      </div>
      <div class="space-y-6 text-xl leading-relaxed md:text-2xl">
        <p>AI isn't the next big thing &mdash; it is <em>the</em> big thing.</p>
        <p>
          Lisbon AI is the annual summit for people shipping AI in the real
          world. No hype decks, no rubber-chicken dinners. Just code, talks, and
          hallway hacking.
        </p>
        <p>
          Join top labs, founding teams, and engineers deploying models in
          production, to chat about where we are now and what's next.
        </p>
        <p>Bring your laptop.</p>

        <div class="small-headline pt-6">//topics-of-discussion</div>
        <ul class="flex flex-wrap items-center gap-3">
          {
            Object.keys(trackDescriptions).map((item, i) => (
              <>
                {i > 0 && <li class="small-headline">+</li>}
                <li>
                  <a
                    href={`${import.meta.env.BASE_URL}schedule/#${item.toLowerCase().replace(/[^a-z0-9]+/g, "-")}`}
                    class="block rounded-full border border-white/10 bg-white/[0.03] px-4 py-2 text-xl transition-colors hover:border-white/20 hover:bg-white/[0.06] md:text-2xl"
                  >
                    {item}
                  </a>
                </li>
              </>
            ))
          }
        </ul>

        <div class="small-headline pt-6">//format</div>
        <ul class="flex flex-wrap items-center gap-3">
          {
            format.map((item, i) => (
              <>
                {i > 0 && <li class="small-headline">+</li>}
                <li>
                  <a
                    href={`${import.meta.env.BASE_URL}schedule/`}
                    class="block rounded-full border border-white/10 bg-white/[0.03] px-4 py-2 text-xl transition-colors hover:border-white/20 hover:bg-white/[0.06] md:text-2xl"
                  >
                    {item}
                  </a>
                </li>
              </>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- Speakers -->
  <section id="speakers" class="scroll-mt-20 border-t border-white/10">
    <div class="mx-auto grid max-w-[90rem] gap-12 py-20 md:grid-cols-12">
      <div class="px-6 md:col-span-4">
        <div class="small-headline">/speakers</div>
      </div>
      <div class="px-3 md:col-span-12 md:px-6">
        <div
          data-home-speaker-grid
          class="grid gap-0 border-x border-white/10 md:grid-cols-2 2xl:grid-cols-3"
        >
          {
            homepageSpeakers.map(({ name, org, role, profileUrl, orgUrl, logo, image, talkType }, i) => (
              <div
                data-home-speaker
                data-talk-type={talkType}
                class:list={[
                  "speaker-texture relative isolate flex-col items-start gap-3 border-b border-white/10 p-8 text-xl md:p-12 md:text-2xl",
                  { flex: talkType === "full" },
                  { "hidden 2xl:flex": talkType === "lightning" },
                  { "border-t border-white/10": i === 0 },
                  // Two columns from md, three from 2xl. Later breakpoints win,
                  // so the 2xl rules reset the md borders where the row changes.
                  { "md:border-l md:border-white/10": i % 2 === 1 },
                  { "md:border-t md:border-white/10": i === 1 },
                  { "2xl:border-l 2xl:border-white/10": i % 3 !== 0 },
                  { "2xl:border-l-0": i % 3 === 0 },
                  { "2xl:border-t 2xl:border-white/10": i === 2 },
                ]}
                style={`--tex-pos: ${texturePositions[i % texturePositions.length]}`}
              >
                <figure class="mb-6 flex h-[160px] w-full items-center justify-center overflow-hidden rounded-2xl">
                  <img
                    src={`${import.meta.env.BASE_URL}images/speakers/${image}`}
                    alt={name}
                    class="h-[160px] w-[160px] rounded-2xl object-cover"
                  />
                </figure>
                <div class="flex w-full items-center justify-between gap-3">
                  <div class="flex flex-col items-start gap-1">
                    <h3>
                      {profileUrl ? (
                        <a href={profileUrl} class="hover:text-muted">
                          {name}
                        </a>
                      ) : (
                        name
                      )}
                    </h3>
                    <span class="font-mono text-xs text-faint">
                      {orgUrl ? (
                        <a href={orgUrl} class="hover:text-muted">
                          //{[role, org].filter(Boolean).join(", ")}
                        </a>
                      ) : (
                        <>//{[role, org].filter(Boolean).join(", ")}</>
                      )}
                    </span>
                  </div>
                  {logo && (orgUrl ? (
                    <a
                      href={orgUrl}
                      class="logo-tint shrink-0"
                      style={`--logo: url("${import.meta.env.BASE_URL}images/logos/${logo}")`}
                    >
                      <img
                        src={`${import.meta.env.BASE_URL}images/logos/${logo}`}
                        alt={org}
                        class:list={["w-auto", logoHeight(logo)]}
                      />
                    </a>
                  ) : (
                    <span
                      class="logo-tint shrink-0"
                      style={`--logo: url("${import.meta.env.BASE_URL}images/logos/${logo}")`}
                    >
                      <img
                        src={`${import.meta.env.BASE_URL}images/logos/${logo}`}
                        alt={org}
                        class:list={["w-auto", logoHeight(logo)]}
                      />
                    </span>
                  ))}
                </div>
              </div>
            ))
          }
          <div class="flex flex-col items-center justify-center gap-2 border-b border-white/10 p-8 text-center md:col-span-2 md:p-12 2xl:hidden">
            <p class="text-lg leading-snug md:text-xl">
              And more people shaping AI.
            </p>
            <a
              href={`${import.meta.env.BASE_URL}speakers/`}
              class="mt-2 font-mono text-xs uppercase text-muted underline hover:text-cream"
              >See all speakers</a
            >
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Location -->
  <Location />

  <!-- FAQ -->
  <section class="border-t border-white/10">
    <div class="mx-auto grid max-w-[90rem] gap-12 px-6 py-20 md:grid-cols-2">
      <div>
        <div class="small-headline">/faq</div>
      </div>
      <div>
        {
          faqs.map((faq) => (
            <details class="group border-b border-white/10 py-5">
              <summary class="flex cursor-pointer list-none items-center justify-between text-base md:text-2xl">
                <span>
                  <span class="mr-2 font-mono text-base text-muted md:text-lg">
                    {randomBraille()}
                  </span>
                  {faq.q}
                </span>
                <span class="font-mono text-xs text-faint transition group-open:rotate-45">
                  +
                </span>
              </summary>
              <p class="mt-4 max-w-2xl text-base leading-relaxed text-muted">
                {faq.a}
              </p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Tickets CTA -->
  <section id="tickets" class="border-t border-white/10">
    <div class="mx-auto grid max-w-[90rem] gap-12 px-6 py-24 md:grid-cols-2">
      <div>
        <div class="small-headline">/tickets</div>
      </div>
      <div>
        <p class="max-w-2xl text-2xl leading-snug md:text-3xl">
          The final batch of regular tickets is live. Late bird is next.
        </p>
        <a href="https://tickets.lisbonai.org/lisbonai-2026" class="mt-8 btn-primary">
          Get your ticket &rarr;
        </a>
      </div>
    </div>
  </section>

  <!-- Sponsors -->
  <section id="sponsors" class="border-t border-white/10">
    <div class="mx-auto grid max-w-[90rem] gap-12 py-20 md:grid-cols-12">
      <div class="px-6 md:col-span-4">
        <div class="small-headline">/sponsors</div>
      </div>
      <div class="px-3 md:col-span-12 md:px-6">
        <div>
          {
            sponsorTiers.map((tier) => (
              <div class:list={[tier.panelClass]}>
                <div class="bg-slate-300/[0.02] py-4 pl-4 font-mono text-xs uppercase text-muted">
                  //{tier.label}{tier.label === "Community" ? "" : " sponsors"}
                </div>
                {tier.sponsors.length > 0 ? (
                  <div
                    data-shuffle={tier.sponsors.length > 1 ? "" : undefined}
                    class:list={["grid border-t border-white/10", tier.gridClass ?? "grid-cols-2 sm:grid-cols-3 md:grid-cols-4"]}
                  >
                    {tier.sponsors.map(({ name, url, logo, logoClass }, i) => {
                      const isLast = i === tier.sponsors.length - 1;
                      const img = (
                        <img
                          src={`${import.meta.env.BASE_URL}images/sponsors/${logo}`}
                          alt={name}
                          class:list={["w-auto brightness-0 invert transition-opacity group-hover:opacity-70", logoClass ?? "h-6"]}
                        />
                      );
                      return url ? (
                        <a
                          href={url}
                          class:list={["group flex items-center justify-center border-b border-white/10 p-3 min-h-16", { "border-r": !isLast }]}
                        >
                          {img}
                        </a>
                      ) : (
                        <div class:list={["flex items-center justify-center border-b border-white/10 p-3 min-h-16", { "border-r": !isLast }]}>
                          {img}
                        </div>
                      );
                    })}
                  </div>
                ) : (
                  <p class="font-mono text-xs text-faint">Coming soon</p>
                )}
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<script>
  // Every full session appears on the homepage, but no speaker owns the lead
  // position. The one lightning card only appears when the grid has three
  // columns, filling the final cell without lengthening smaller layouts.
  const speakerGrid = document.querySelector<HTMLElement>(
    "[data-home-speaker-grid]",
  );
  if (speakerGrid) {
    const fullSessions = Array.from(
      speakerGrid.querySelectorAll<HTMLElement>(
        '[data-home-speaker][data-talk-type="full"]',
      ),
    );
    const lightning = speakerGrid.querySelector<HTMLElement>(
      '[data-home-speaker][data-talk-type="lightning"]',
    );

    for (let i = fullSessions.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [fullSessions[i], fullSessions[j]] = [fullSessions[j], fullSessions[i]];
    }
    fullSessions.forEach((card) => speakerGrid.insertBefore(card, lightning));

    [...fullSessions, ...(lightning ? [lightning] : [])].forEach((card, i) => {
      card.classList.toggle("border-t", i === 0);
      card.classList.toggle("md:border-l", i % 2 === 1);
      card.classList.toggle("md:border-t", i === 1);
      card.classList.toggle("2xl:border-l", i % 3 !== 0);
      card.classList.toggle("2xl:border-l-0", i % 3 === 0);
      card.classList.toggle("2xl:border-t", i === 2);
    });
  }

  // Sponsors within a tier are peers, so their order is reshuffled on every
  // load rather than baked in at build time.
  document.querySelectorAll<HTMLElement>("[data-shuffle]").forEach((grid) => {
    const cells = Array.from(grid.children) as HTMLElement[];
    for (let i = cells.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [cells[i], cells[j]] = [cells[j], cells[i]];
    }
    // The divider belongs to position, not to the logo that moved into it:
    // every cell but the last carries the right border.
    cells.forEach((cell, i) => {
      grid.appendChild(cell);
      cell.classList.toggle("border-r", i < cells.length - 1);
    });
  });
</script>
