---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Footer from "../components/Footer.astro";
import Location from "../components/Location.astro";

import { format } from "../data/format";
import { faqs } from "../data/faqs";
import { speakers } from "../data/speakers";

const brailleFrames = ["⣾", "⣽", "⣻", "⢿", "⡿", "⣟", "⣯", "⣷"];
const randomBraille = () =>
  brailleFrames[Math.floor(Math.random() * brailleFrames.length)];
---

<Layout>
  <Header />
  <Hero />

  <!-- What to expect -->
  <section class="border-t border-white/10">
    <div class="mx-auto grid max-w-6xl gap-12 px-6 py-20 md:grid-cols-12">
      <div class="md:col-span-4">
        <div class="small-headline">/what-to-expect</div>
      </div>
      <div class="space-y-6 text-xl leading-relaxed md:col-span-8 md:text-2xl">
        <p>AI isn't the next big thing &mdash; it is the big thing.</p>
        <p>
          Lisbon AI is the annual summit for people shipping AI in the real
          world. No hype decks, no rubber-chicken dinners. Just code, talks, and
          hallway hacking.
        </p>
        <p>
          Join top labs, founding teams, and engineers deploying models in
          production, to chat about where we are now and what's next.
        </p>
        <p>Bring your laptop.</p>
      </div>
    </div>
  </section>

  <!-- Format -->
  <section id="format" class="border-t border-white/10">
    <div class="mx-auto grid max-w-6xl gap-12 px-6 py-20 md:grid-cols-12">
      <div class="md:col-span-4">
        <div class="small-headline">/format</div>
      </div>
      <ul class="md:col-span-8">
        {
          format.map((item) => (
            <li class="flex items-baseline justify-between border-b border-white/10 py-5 text-xl md:text-2xl">
              <span>{item}</span>
              <span class="font-mono text-xs text-faint">&rarr;</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Speakers -->
  <section id="speakers" class="border-t border-white/10">
    <div class="mx-auto grid max-w-6xl gap-12 px-6 py-20 md:grid-cols-12">
      <div class="md:col-span-4">
        <div class="small-headline">/speakers</div>
      </div>
      <div class="md:col-span-8">
        <div class="grid gap-12 sm:grid-cols-3">
          {
            speakers.map(({ name, org, profileUrl, orgUrl, image }) => (
              <div class="flex flex-col items-center gap-3 py-5 text-xl md:text-2xl">
                <img
                  src={`${import.meta.env.BASE_URL}images/speakers/${image}`}
                  alt={name}
                  class="h-[200px] w-[200px] rounded-full object-cover"
                />
                <div class="flex w-full flex-col items-center gap-1">
                  <h3>
                    {profileUrl ? (
                      <a href={profileUrl} class="hover:text-muted">
                        {name}
                      </a>
                    ) : (
                      name
                    )}
                  </h3>
                  <span class="font-mono text-xs text-faint">
                    {orgUrl ? (
                      <a href={orgUrl} class="hover:text-muted">
                        {org}
                      </a>
                    ) : (
                      org
                    )}
                  </span>
                </div>
              </div>
            ))
          }
          <div
            class="flex flex-col items-center justify-center gap-2 py-5 text-center sm:col-span-2"
          >
            <p class="text-lg leading-snug md:text-xl">
              More speakers landing every few days.
            </p>
            <p class="font-mono text-xs text-faint">
              Keep an eye on this space &rarr;
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CFP CTA -->
  <section id="cfp" class="border-t border-white/10">
    <div class="mx-auto grid max-w-6xl gap-12 px-6 py-20 md:grid-cols-12">
      <div class="md:col-span-4">
        <div class="small-headline">/call-for-proposals</div>
      </div>
      <div class="md:col-span-8">
        <p class="max-w-3xl text-2xl leading-snug md:text-3xl">
          We are looking for deeply technical talks and demos from people
          building real AI systems or workflows.
        </p>
        <p class="mt-5 max-w-2xl text-lg leading-relaxed text-muted">
          CFP closes June 30.
        </p>
        <a href={`${import.meta.env.BASE_URL}cfp/`} class="mt-8 btn-primary">
          Read the CFP &rarr;
        </a>
      </div>
    </div>
  </section>

  <!-- Location -->
  <Location />

  <!-- FAQ -->
  <section class="border-t border-white/10">
    <div class="mx-auto grid max-w-6xl gap-12 px-6 py-20 md:grid-cols-12">
      <div class="md:col-span-4">
        <div class="small-headline">/faq</div>
      </div>
      <div class="md:col-span-8">
        {
          faqs.map((faq) => (
            <details class="group border-b border-white/10 py-5">
              <summary class="flex cursor-pointer list-none items-center justify-between text-base md:text-2xl">
                <span>
                  <span class="mr-2 font-mono text-base text-muted md:text-lg">
                    {randomBraille()}
                  </span>
                  {faq.q}
                </span>
                <span class="font-mono text-xs text-faint transition group-open:rotate-45">
                  +
                </span>
              </summary>
              <p class="mt-4 max-w-2xl text-base leading-relaxed text-muted">
                {faq.a}
              </p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Tickets CTA -->
  <section id="tickets" class="border-t border-white/10">
    <div class="mx-auto grid max-w-6xl gap-12 px-6 py-24 md:grid-cols-12">
      <div class="md:col-span-4">
        <div class="small-headline">/tickets</div>
      </div>
      <div class="md:col-span-8">
        <p class="max-w-2xl text-2xl leading-snug md:text-3xl">
          We're slowly starting to roll out to tickets to the 2026 edition of
          Lisbon AI.
        </p>
        <a href="https://tickets.lisbonai.org/" class="mt-8 btn-primary">
          Get your ticket &rarr;
        </a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
