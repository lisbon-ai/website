---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";

import { speakers } from "../data/speakers";
import { format } from "../data/format";
import { faqs } from "../data/faqs";
---

<Layout>
    <Header />
    <Hero />

    <!-- What to expect -->
    <section class="border-t border-white/10">
        <div class="mx-auto grid max-w-6xl gap-12 px-6 py-20 md:grid-cols-12">
            <div class="md:col-span-4">
                <div
                    class="font-mono text-xs uppercase tracking-widest text-muted"
                >
                    [What to expect]
                </div>
            </div>
            <div
                class="space-y-6 text-xl leading-relaxed md:col-span-8 md:text-2xl"
            >
                <p>AI isn't the next big thing - it is the big thing.</p>
                <p>
                    Lisbon AI is the annual summit for people shipping AI in the
                    real world. No hype decks, no rubber-chicken dinners &mdash;
                    just code, talks, and hallway hacking.
                </p>
                <p>
                    Join top labs, founding teams, and engineers deploying
                    models in production, to chat about where we are now and
                    what's next.
                </p>
                <p>Bring your laptop.</p>
            </div>
        </div>
    </section>

    <!-- Format -->
    <section id="format" class="border-t border-white/10">
        <div class="mx-auto grid max-w-6xl gap-12 px-6 py-20 md:grid-cols-12">
            <div class="md:col-span-4">
                <div
                    class="font-mono text-xs uppercase tracking-widest text-muted"
                >
                    [Format]
                </div>
            </div>
            <ul class="md:col-span-8">
                {
                    format.map((item) => (
                        <li class="flex items-baseline justify-between border-b border-white/10 py-5 text-xl md:text-2xl">
                            <span>{item}</span>
                            <span class="font-mono text-xs text-faint">
                                &rarr;
                            </span>
                        </li>
                    ))
                }
            </ul>
        </div>
    </section>

    <!-- FAQ -->
    <section class="border-t border-white/10">
        <div class="mx-auto grid max-w-6xl gap-12 px-6 py-20 md:grid-cols-12">
            <div class="md:col-span-4">
                <div
                    class="font-mono text-xs uppercase tracking-widest text-muted"
                >
                    [FAQ]
                </div>
            </div>
            <div class="md:col-span-8">
                {
                    faqs.map((faq) => (
                        <details class="group border-b border-white/10 py-5">
                            <summary class="flex cursor-pointer list-none items-center justify-between text-xl md:text-2xl">
                                <span>{faq.q}</span>
                                <span class="font-mono text-xs text-faint transition group-open:rotate-45">
                                    +
                                </span>
                            </summary>
                            <p class="mt-4 max-w-2xl text-base leading-relaxed text-muted">
                                {faq.a}
                            </p>
                        </details>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- Sponsors -->
    <section class="border-t border-white/10">
        <div class="mx-auto max-w-6xl px-6 py-20">
            <div
                class="mb-12 font-mono text-xs uppercase tracking-widest text-muted"
            >
                [ Sponsors ]
            </div>
            <div class="space-y-12">
                <div>
                    <div
                        class="mb-4 font-mono text-xs uppercase tracking-widest text-muted"
                    >
                        Gold Sponsors
                    </div>
                    <div class="text-faint">Coming soon.</div>
                </div>
                <div>
                    <div
                        class="mb-4 font-mono text-xs uppercase tracking-widest text-muted"
                    >
                        Silver Sponsors
                    </div>
                    <div class="text-faint">Coming soon.</div>
                </div>
                <div>
                    <div
                        class="mb-4 font-mono text-xs uppercase tracking-widest text-muted"
                    >
                        Community Sponsors
                    </div>
                    <div class="text-faint">Coming soon.</div>
                </div>
            </div>
        </div>
    </section>

    <!-- Tickets CTA -->
    <section id="tickets" class="border-t border-white/10">
        <div class="mx-auto grid max-w-6xl gap-12 px-6 py-24 md:grid-cols-12">
            <div class="md:col-span-4">
                <div
                    class="font-mono text-xs uppercase tracking-widest text-muted"
                >
                    [ Tickets ]
                </div>
            </div>
            <div class="md:col-span-8">
                <p class="max-w-2xl text-2xl leading-snug md:text-3xl">
                    We're organizing highly curated technical sessions for
                    engineers, for researchers. Sign up to be part of this.
                </p>
                <a
                    href="#"
                    class="mt-8 inline-block rounded-full bg-cream-warm px-6 py-3 text-ink hover:bg-cream"
                >
                    Get tickets &rarr;
                </a>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="border-t border-white/10">
        <div class="mx-auto grid max-w-6xl gap-10 px-6 py-16 md:grid-cols-4">
            <div class="md:col-span-2">
                <div
                    class="font-mono text-sm font-medium uppercase tracking-widest"
                >
                    Lisbon AI
                </div>
                <p class="mt-3 max-w-xs text-sm text-muted">
                    The annual summit for people shipping AI in the real world.
                </p>
            </div>
            <div>
                <div
                    class="mb-3 font-mono text-xs uppercase tracking-widest text-muted"
                >
                    About
                </div>
                <ul class="space-y-2 text-sm">
                    <li><a href="#" class="hover:text-muted">About</a></li>
                    <li>
                        <a href="#speakers" class="hover:text-muted">Speakers</a
                        >
                    </li>
                    <li><a href="#" class="hover:text-muted">Sponsors</a></li>
                    <li>
                        <a href="#" class="hover:text-muted">Code of Conduct</a>
                    </li>
                </ul>
            </div>
            <div>
                <div
                    class="mb-3 font-mono text-xs uppercase tracking-widest text-muted"
                >
                    Need help?
                </div>
                <ul class="space-y-2 text-sm">
                    <li>
                        <a href="#tickets" class="hover:text-muted">Tickets</a>
                    </li>
                    <li>
                        <a href="https://discord.gg/" class="hover:text-muted"
                            >Discord</a
                        >
                    </li>
                    <li>
                        <a
                            href="https://x.com/lisbonaiconf"
                            class="hover:text-muted">X</a
                        >
                    </li>
                    <li><a href="#" class="hover:text-muted">Privacy</a></li>
                </ul>
            </div>
        </div>
        <div
            class="mx-auto flex max-w-6xl items-center justify-between border-t border-white/10 px-6 py-6 font-mono text-xs uppercase tracking-widest text-muted"
        >
            <span>&copy; 2026 Lisbon AI</span>
            <span>Lisbon &mdash; Portugal</span>
        </div>
    </footer>
</Layout>
