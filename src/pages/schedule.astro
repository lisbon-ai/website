---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

import { days, formatTime, trackDescriptions } from "../data/schedule";
import { hasTalk, speakers as siteSpeakers } from "../data/speakers";
import TalkLine from "../components/TalkLine.astro";

// Each track is anchored at its first appearance so //topics-of-discussion on
// the landing page can link straight to it.
const slugify = (title: string) =>
  title.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");

// The talk list and the row of photos under it share one order, so a slot's
// names are sorted and filtered in one place.
const lineup = (names: string[]) =>
  [...names].sort((a, b) => a.localeCompare(b)).filter(hasTalk);

const speakerByName = new Map(
  siteSpeakers.map((speaker) => [speaker.name, speaker]),
);

const anchoredAt = new Map<string, string>();
days.forEach((day, dayIndex) =>
  day.slots.forEach((slot, slotIndex) => {
    if (!slot.kind && !anchoredAt.has(slot.title)) {
      anchoredAt.set(slot.title, `${dayIndex}-${slotIndex}`);
    }
  }),
);
---

<Layout
  title="Schedule — Lisbon AI 2026"
  description="The two-day programme for Lisbon AI 2026, September 23-24 at Centro Champalimaud."
>
  <Header />

  <main>
    <section class="border-t border-white/10">
      <div class="mx-auto max-w-3xl py-16 px-6 md:px-0">
        <div class="small-headline mb-4">/topics-of-discussion</div>

        <div class="mb-16 border-b border-white/10">
          {
            Object.entries(trackDescriptions).map(([track, description]) => (
              <div class="grid gap-2 border-t border-white/10 py-5 md:grid-cols-[11rem_1fr] md:gap-6">
                <h2 class="font-mono text-xs uppercase text-faint">{track}</h2>
                <p class="text-sm leading-relaxed text-soft">{description}</p>
              </div>
            ))
          }
        </div>

        <div class="small-headline mb-4">/schedule</div>

        <div>
          <div class="flex flex-col gap-16">
            {
              days.map(({ label, date, slots }, dayIndex) => (
                <div>
                  <h2 class="font-display text-3xl font-bold uppercase tracking-tight mb-8">
                    {label}, {date}
                  </h2>

                  {slots.length > 0 ? (
                    <ul class="flex flex-col border-b border-white/10">
                      {slots.map(({ start, end, title, kind, host, org, speakers }, slotIndex) => (
                        <li
                          id={
                            anchoredAt.get(title) === `${dayIndex}-${slotIndex}`
                              ? slugify(title)
                              : undefined
                          }
                          class="flex scroll-mt-24 flex-col gap-4 border-t border-white/10 py-4 md:flex-row md:items-baseline md:gap-6"
                        >
                          <div class="shrink-0 font-mono text-xs md:w-44">
                            <div class="text-faint">
                              {formatTime(start)} &ndash; {formatTime(end)}
                            </div>
                            {speakers && (
                              <div class="mt-1.5 uppercase text-muted">{title}</div>
                            )}
                          </div>
                          <div class="min-w-0 text-base md:flex-1 md:text-lg">
                            {!speakers && (
                              host && title.includes(host.name) ? (
                                <>
                                  {title.slice(0, title.indexOf(host.name))}
                                  {/* Kept on one line: whitespace here lands
                                      inside the anchor and gets underlined. */}
                                  <a
                                    href={host.url}
                                    class="underline decoration-white/30 underline-offset-4 hover:decoration-white"
                                  >{host.name}</a>
                                  {title.slice(title.indexOf(host.name) + host.name.length)}
                                </>
                              ) : (
                                title
                              )
                            )}
                            {org && (
                              <a
                                href={org.url}
                                class="group ml-3 inline-flex -translate-y-[0.1em] items-center align-middle"
                              >
                                {/* Masked rather than an <img> so the mark can take a
                                    theme colour; the ratio rides along in logoClass. */}
                                <span
                                  role="img"
                                  aria-label={org.name}
                                  class:list={[
                                    "block bg-muted transition-colors group-hover:bg-cream",
                                    org.logoClass ?? "h-4",
                                  ]}
                                  style={`-webkit-mask:url(${import.meta.env.BASE_URL}images/logos/${org.logo}) center/contain no-repeat;mask:url(${import.meta.env.BASE_URL}images/logos/${org.logo}) center/contain no-repeat`}
                                />
                              </a>
                            )}
                            {speakers && (
                              <>
                                <ul class="flex flex-col gap-4">
                                  {lineup(speakers).map((name) => (
                                    <TalkLine name={name} />
                                  ))}
                                </ul>
                                {/* The block closes on its line-up, in the same
                                    order as the talks above. Speakers still
                                    waiting on a photo simply sit this out. */}
                                <div class="mt-5 flex flex-wrap gap-2 md:gap-3">
                                  {lineup(speakers)
                                    .map((name) => speakerByName.get(name))
                                    .filter((speaker) => speaker?.image)
                                    .map((speaker) => (
                                      <img
                                        src={`${import.meta.env.BASE_URL}images/speakers/${speaker!.image}`}
                                        alt={speaker!.name}
                                        title={speaker!.name}
                                        class="h-14 w-14 rounded-lg object-cover md:h-20 md:w-20 md:rounded-xl"
                                      />
                                    ))}
                                </div>
                              </>
                            )}
                          </div>
                        </li>
                      ))}
                    </ul>
                  ) : (
                    <div class="border-t border-white/10 py-8">
                      <p class="text-lg leading-snug md:text-xl">
                        The {label.toLowerCase()} programme lands soon.
                      </p>
                      <p class="mt-2 font-mono text-xs text-faint">
                        Keep an eye on this space
                      </p>
                    </div>
                  )}
                  <p class="mt-4 font-mono text-xs text-faint">
                    Times are subject to change. More talks and talk titles will
                    be announced as they are confirmed.
                  </p>
                </div>
              ))
            }
          </div>
        </div>

      </div>
    </section>
  </main>

  <Footer />
</Layout>
