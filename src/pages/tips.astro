---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const base = import.meta.env.BASE_URL;

const brailleFrames = ["⣾", "⣽", "⣻", "⢿", "⡿", "⣟", "⣯", "⣷"];
const randomBraille = () =>
  brailleFrames[Math.floor(Math.random() * brailleFrames.length)];

// Venue photos for the "getting there" column — one is picked at random on
// every page load by the client script below.
const venuePhotos = [1, 2, 3, 4].map(
  (n) => `${base}images/venue/${n}.jpg`,
);
const defaultPhoto = venuePhotos[0];

const stayMapZoom = 13;
const stayMapPoints = [
    {
        label: "LXAI",
        name: "Centro Champalimaud",
        kind: "venue",
        lat: 38.693147,
        lon: -9.220878,
    },
    {
        label: "1",
        name: "The Emerald House Lisbon",
        kind: "hotel",
        lat: 38.705,
        lon: -9.16219,
    },
    {
        label: "2",
        name: "Valverde Lisboa Hotel & Garden",
        kind: "hotel",
        lat: 38.719716,
        lon: -9.144646,
    },
    {
        label: "3",
        name: "Lisboa Pessoa Hotel",
        kind: "hotel",
        lat: 38.7125123,
        lon: -9.1414479,
    },
    {
        label: "4",
        name: "Sublime Lisboa",
        kind: "hotel",
        lat: 38.725681,
        lon: -9.157112,
    },
    {
        label: "5",
        name: "DUO Hotel Lisbon",
        kind: "hotel",
        lat: 38.70775,
        lon: -9.149333,
    },
    {
        label: "6",
        name: "Art Legacy",
        kind: "hotel",
        lat: 38.71104,
        lon: -9.13881,
        offsetX: -1.4,
        offsetY: 2,
    },
    {
        label: "7",
        name: "My Story Tejo",
        kind: "hotel",
        lat: 38.71361,
        lon: -9.13678,
        offsetX: 1.4,
        offsetY: -1.8,
    },
    {
        label: "8",
        name: "My Story Figueira",
        kind: "hotel",
        lat: 38.7135,
        lon: -9.137539,
        offsetX: 2,
        offsetY: 1.8,
    },
    {
        label: "9",
        name: "Mama Shelter Lisboa",
        kind: "hotel",
        lat: 38.72092,
        lon: -9.15262,
    },
    {
        label: "10",
        name: "Jupiter Lisboa Hotel",
        kind: "hotel",
        lat: 38.739622,
        lon: -9.145858,
    },
];

const tileCount = 2 ** stayMapZoom;
const lonToTileX = (lon: number) => ((lon + 180) / 360) * tileCount;
const latToTileY = (lat: number) => {
    const radians = (lat * Math.PI) / 180;
    return (
        ((1 -
            Math.log(Math.tan(radians) + 1 / Math.cos(radians)) / Math.PI) /
            2) *
        tileCount
    );
};

const projectedStayMapPoints = stayMapPoints.map((point) => ({
    ...point,
    tileX: lonToTileX(point.lon),
    tileY: latToTileY(point.lat),
}));

const stayMapMinX = Math.floor(
    Math.min(...projectedStayMapPoints.map((point) => point.tileX)),
) - 1;
const stayMapMaxX = Math.floor(
    Math.max(...projectedStayMapPoints.map((point) => point.tileX)),
) + 1;
const stayMapMinY = Math.floor(
    Math.min(...projectedStayMapPoints.map((point) => point.tileY)),
) - 1;
const stayMapMaxY = Math.floor(
    Math.max(...projectedStayMapPoints.map((point) => point.tileY)),
) + 1;

const stayMapCols = stayMapMaxX - stayMapMinX + 1;
const stayMapRows = stayMapMaxY - stayMapMinY + 1;
const stayMapTiles = Array.from({ length: stayMapRows }, (_, row) =>
    Array.from({ length: stayMapCols }, (_, col) => ({
        x: stayMapMinX + col,
        y: stayMapMinY + row,
    })),
).flat();

const stayMapMarkers = projectedStayMapPoints.map((point) => ({
    ...point,
    x:
        ((point.tileX - stayMapMinX) / stayMapCols) * 100 +
        (point.offsetX ?? 0),
    y:
        ((point.tileY - stayMapMinY) / stayMapRows) * 100 +
        (point.offsetY ?? 0),
}));
---

<Layout
    title="Tips for Attendees — Lisbon AI 2026"
    description="Practical tips for making the most of Lisbon AI 2026 — getting to the venue in Belém, where to stay, what to bring, and how to get around Lisbon."
>
    <Header />

    <!-- Intro -->
    <section class="border-t border-white/10">
        <div class="mx-auto grid max-w-[90rem] gap-12 px-6 py-20 md:grid-cols-2">
            <div>
                <div class="small-headline mb-4">/tips</div>
                <h1
                    class="font-display text-3xl font-bold uppercase tracking-tight mb-8"
                >
                    Tips for Attendees
                </h1>
                <p class="text-xl leading-relaxed">
                    Here are some tips and recommendations from our team to help
                    you organize and plan your trip to Lisbon AI.
                </p>
            </div>
            <div></div>
        </div>
    </section>

    <!-- Getting there -->
    <section class="border-t border-white/10">
        <div class="mx-auto grid max-w-[90rem] gap-12 px-6 py-16 md:grid-cols-2">
            <div>
                <h2 class="small-headline" aria-label="Getting there">
                    <span aria-hidden="true">/getting-there</span>
                </h2>
                <img
                    id="getting-there-photo"
                    src={defaultPhoto}
                    alt="Centro Champalimaud, the Lisbon AI venue"
                    class="mt-6 aspect-[3/2] w-full rounded-2xl border border-white/10 object-cover"
                />
            </div>
            <script define:vars={{ venuePhotos }}>
                const img = document.getElementById("getting-there-photo");
                if (img && venuePhotos.length) {
                    img.src =
                        venuePhotos[
                            Math.floor(Math.random() * venuePhotos.length)
                        ];
                }
            </script>
            <div class="text-base leading-relaxed md:mt-10">
                <p>
                    The venue is <strong>Centro Champalimaud</strong> on the
                    Belém waterfront, west of central Lisbon. Here's how to get
                    there:
                </p>
                <h3 class="small-headline mt-8 mb-2" aria-label="By car">
                    <span aria-hidden="true">//By car</span>
                </h3>
                <details class="group border-b border-white/10 py-2">
                    <summary
                        class="flex cursor-pointer list-none items-center justify-between text-base"
                    >
                        <span>
                            <span
                                class="mr-2 font-mono text-base text-muted md:text-lg"
                            >
                                {randomBraille()}
                            </span>
                            Paid parking inside the venue: €9.90 for a daily ticket
                        </span>
                        <span
                            class="font-mono text-xs text-faint transition group-open:rotate-45"
                        >
                            +
                        </span>
                    </summary>
                    <div class="mt-4 space-y-3 text-base leading-relaxed text-muted">
                        <img
                            src={`${base}images/getting-there/park-inside.jpg`}
                            alt="Map of the paid parking inside the Champalimaud venue"
                            class="w-full max-w-md rounded-lg border border-white/10"
                            loading="lazy"
                        />
                        <p>
                            <a
                                href="https://maps.app.goo.gl/1RWGU1mDKyCxrtrr6"
                                target="_blank"
                                rel="noopener noreferrer"
                                class="underline hover:text-cream"
                                >View on Google Maps</a
                            >
                        </p>
                    </div>
                </details>
                <details class="group border-b border-white/10 py-2">
                    <summary
                        class="flex cursor-pointer list-none items-center justify-between text-base"
                    >
                        <span>
                            <span
                                class="mr-2 font-mono text-base text-muted md:text-lg"
                            >
                                {randomBraille()}
                            </span>
                            Free parking outside the venue: fills up quickly
                        </span>
                        <span
                            class="font-mono text-xs text-faint transition group-open:rotate-45"
                        >
                            +
                        </span>
                    </summary>
                    <div class="mt-4 text-base leading-relaxed text-muted">
                        <img
                            src={`${base}images/getting-there/park-outside.jpg`}
                            alt="Map of free street parking near the venue along Avenida de Brasília"
                            class="w-full max-w-md rounded-lg border border-white/10"
                            loading="lazy"
                        />
                    </div>
                </details>
                <h3
                    class="small-headline mt-8 mb-2"
                    aria-label="By public transport"
                >
                    <span aria-hidden="true">//By public transport</span>
                </h3>
                <details class="group border-b border-white/10 py-2">
                    <summary
                        class="flex cursor-pointer list-none items-center justify-between text-base"
                    >
                        <span>
                            <span
                                class="mr-2 font-mono text-base text-muted md:text-lg"
                            >
                                {randomBraille()}
                            </span>
                            Tram, surface tram from Baixa toward Belém
                        </span>
                        <span
                            class="font-mono text-xs text-faint transition group-open:rotate-45"
                        >
                            +
                        </span>
                    </summary>
                    <div class="mt-4 space-y-3 text-base leading-relaxed text-muted">
                        <img
                            src={`${base}images/getting-there/tram.jpg`}
                            alt="Public transport routes from central Lisbon to the venue"
                            class="w-full max-w-md rounded-lg border border-white/10"
                            loading="lazy"
                        />
                        <p>
                            <a
                                href="https://maps.app.goo.gl/Ckc3FHLTfPZx3KEP7"
                                target="_blank"
                                rel="noopener noreferrer"
                                class="underline hover:text-cream"
                                >View on Google Maps</a
                            >
                        </p>
                    </div>
                </details>
                <details class="group border-b border-white/10 py-2">
                    <summary
                        class="flex cursor-pointer list-none items-center justify-between text-base"
                    >
                        <span>
                            <span
                                class="mr-2 font-mono text-base text-muted md:text-lg"
                            >
                                {randomBraille()}
                            </span>
                            Bus, several bus stops serve the area
                        </span>
                        <span
                            class="font-mono text-xs text-faint transition group-open:rotate-45"
                        >
                            +
                        </span>
                    </summary>
                    <div class="mt-4 text-base leading-relaxed text-muted">
                        <img
                            src={`${base}images/getting-there/bus-stops.jpg`}
                            alt="Map of bus stops around the venue in Pedrouços"
                            class="w-full max-w-md rounded-lg border border-white/10"
                            loading="lazy"
                        />
                    </div>
                </details>
                <details class="group border-b border-white/10 py-2">
                    <summary
                        class="flex cursor-pointer list-none items-center justify-between text-base"
                    >
                        <span>
                            <span
                                class="mr-2 font-mono text-base text-muted md:text-lg"
                            >
                                {randomBraille()}
                            </span>
                            Train, Estação Algés, a 13-minute walk (Cascais–Cais do
                            Sodré line)
                        </span>
                        <span
                            class="font-mono text-xs text-faint transition group-open:rotate-45"
                        >
                            +
                        </span>
                    </summary>
                    <div class="mt-4 space-y-3 text-base leading-relaxed text-muted">
                        <img
                            src={`${base}images/getting-there/walk.jpg`}
                            alt="Walking route from Estação Algés to the venue, about 13 minutes"
                            class="w-full max-w-md rounded-lg border border-white/10"
                            loading="lazy"
                        />
                        <p>
                            <a
                                href="https://maps.app.goo.gl/hfhbXUdR28gPdWmt5"
                                target="_blank"
                                rel="noopener noreferrer"
                                class="underline hover:text-cream"
                                >View on Google Maps</a
                            >
                        </p>
                    </div>
                </details>
                <h3 class="small-headline mt-8 mb-2" aria-label="Getting around">
                    <span aria-hidden="true">//Getting around</span>
                </h3>
                <p>
                    Once you're in Lisbon, the metro, trams, and buses are cheap
                    and reliable — grab a rechargeable Navegante / Viva Viagem
                    card at any station. Bolt and Uber are everywhere and
                    affordable. The centre is walkable, just expect hills and
                    cobblestones.
                </p>
            </div>
        </div>
    </section>

    <!-- Flying partner -->
    <section class="border-t border-white/10">
        <div class="mx-auto grid max-w-[90rem] gap-12 px-6 py-16 md:grid-cols-2">
            <div>
                <h2 class="small-headline" aria-label="Flying partner">
                    <span aria-hidden="true">/flying-partner</span>
                </h2>
                <img
                    src={`${base}images/logos/tap.svg`}
                    alt="TAP Air Portugal"
                    class="mt-6 h-6 w-auto"
                />
            </div>
            <div class="text-base leading-relaxed">
                <p>
                    <strong>TAP Air Portugal</strong> is our official flying
                    partner. Book directly on <a
                        href="https://www.flytap.com"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="underline hover:text-cream">flytap.com</a
                    > with the event code to get:
                </p>
                <ul class="mt-4 space-y-2 list-disc pl-6">
                    <li>
                        <strong>10% off</strong> Economy class (excluding Brand Discount
                        fares).
                    </li>
                    <li><strong>15% off</strong> Business class.</li>
                </ul>
                <p class="mt-4">
                    If you're a registered attendee, you can use codes <strong
                        >IT26TPCG68</strong
                    > and <strong>IT26TPCG68C</strong> to
                    get your discount.
                </p>
                <h3 class="small-headline mt-8 mb-2" aria-label="Conditions">
                    <span aria-hidden="true">//Conditions</span>
                </h3>
                <details class="group border-b border-white/10 py-2">
                    <summary
                        class="flex cursor-pointer list-none items-center justify-between text-base"
                    >
                        <span>
                            <span
                                class="mr-2 font-mono text-base text-muted md:text-lg"
                            >
                                {randomBraille()}
                            </span>
                            Full booking conditions
                        </span>
                        <span
                            class="font-mono text-xs text-faint transition group-open:rotate-45"
                        >
                            +
                        </span>
                    </summary>
                    <ul
                        class="mt-4 space-y-2 list-disc pl-6 text-base leading-relaxed text-muted"
                    >
                        <li>
                            The discount applies only to bookings made directly
                            on flytap.com — bookings through travel agencies or at
                            TAP counters do not qualify. Pay by credit card or
                            another method available on the website.
                        </li>
                        <li>
                            Valid on round trips from any TAP destination to
                            Lisbon, on TAP-operated flights only. Code-share
                            flights operated by other airlines, or flights on
                            other airlines, do not qualify.
                        </li>
                        <li>
                            You can book at any time, but travel dates must fall
                            within 10 days before and 10 days after the event, and
                            must include the event dates.
                        </li>
                        <li>
                            Not valid on resident, student, child, infant, senior,
                            or similar fares.
                        </li>
                        <li>
                            The event's specific code must be entered when booking
                            online to receive the discount.
                        </li>
                        <li>
                            Changes and refunds follow the rules of the fare you
                            choose, so consider a more flexible fare. Any permitted
                            change is made via <a
                                href="https://www.flytap.com"
                                target="_blank"
                                rel="noopener noreferrer"
                                class="underline hover:text-cream">flytap.com</a
                            > or the TAP contact center.
                        </li>
                    </ul>
                </details>
            </div>
        </div>
    </section>

    <!-- Where to stay -->
    <section class="border-t border-white/10">
        <div class="mx-auto grid max-w-[90rem] gap-12 px-6 py-16 md:grid-cols-2">
            <div>
                <h2 class="small-headline" aria-label="Where to stay">
                    <span aria-hidden="true">/where-to-stay</span>
                </h2>
                <div
                    class="mt-6 overflow-hidden rounded-2xl border border-white/10 bg-ink/50"
                    aria-label="Map of Lisbon AI venue and partner hotels"
                >
                    <div class="relative aspect-[5/4] overflow-hidden">
                        <div
                            class="grid h-full w-full"
                            style={`grid-template-columns: repeat(${stayMapCols}, minmax(0, 1fr)); grid-template-rows: repeat(${stayMapRows}, minmax(0, 1fr));`}
                            aria-hidden="true"
                        >
                            {
                                stayMapTiles.map((tile) => (
                                    <img
                                        src={`https://tile.openstreetmap.org/${stayMapZoom}/${tile.x}/${tile.y}.png`}
                                        alt=""
                                        class="h-full w-full object-cover opacity-85 saturate-[0.75]"
                                        loading="lazy"
                                    />
                                ))
                            }
                        </div>
                        <div
                            class="pointer-events-none absolute inset-0 bg-ink/10 mix-blend-multiply"
                            aria-hidden="true"
                        ></div>
                        {
                            stayMapMarkers.map((point) =>
                                point.kind === "venue" ? (
                                    <span
                                        class="absolute z-10 flex h-5 min-w-10 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full border border-cream bg-[#040429] px-2 font-mono text-[10px] font-bold text-cream shadow-[0_0_0_3px_rgb(4_4_41_/_0.45)]"
                                        style={`left: ${point.x}%; top: ${point.y}%;`}
                                        title={point.name}
                                    >
                                        {point.label}
                                        <span class="sr-only">
                                            {point.name}
                                        </span>
                                    </span>
                                ) : (
                                    <button
                                        type="button"
                                        data-stay-marker={point.label}
                                        class="absolute z-10 flex h-5 min-w-5 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full border border-[#aaa5ff] bg-[#5148c8] px-1 font-mono text-[10px] font-bold text-cream shadow-[0_0_0_3px_rgb(4_4_41_/_0.45)] transition hover:scale-110 focus:outline-none focus:ring-2 focus:ring-cream/70"
                                        style={`left: ${point.x}%; top: ${point.y}%;`}
                                        title={point.name}
                                        aria-label={`Open ${point.name} details`}
                                    >
                                        {point.label}
                                    </button>
                                ),
                            )
                        }
                        <p class="absolute bottom-2 left-2 z-20 rounded bg-ink/85 px-2 py-1 font-mono text-[9px] uppercase text-cream/70">
                            Map data &copy; <a
                                href="https://www.openstreetmap.org/copyright"
                                target="_blank"
                                rel="noopener noreferrer"
                                class="underline hover:text-cream">OpenStreetMap contributors</a
                            >
                        </p>
                    </div>
                </div>
                <script>
                    const stayMarkers = document.querySelectorAll<HTMLButtonElement>(
                        "[data-stay-marker]",
                    );
                    const stayEntries = Array.from(
                        document.querySelectorAll<HTMLDetailsElement>(
                            "[data-stay-entry]",
                        ),
                    );

                    stayMarkers.forEach((marker) => {
                        marker.addEventListener("click", () => {
                            const label = marker.dataset.stayMarker;
                            const entry = stayEntries.find((details) =>
                                details.dataset.stayEntry
                                    ?.split(" ")
                                    .includes(label ?? ""),
                            );

                            if (!entry) return;

                            entry.open = true;

                            const summary = entry.querySelector("summary");
                            summary?.focus({ preventScroll: true });
                            summary?.scrollIntoView({
                                behavior: window.matchMedia(
                                    "(prefers-reduced-motion: reduce)",
                                ).matches
                                    ? "auto"
                                    : "smooth",
                                block: "center",
                            });
                        });
                    });
                </script>
            </div>
            <div class="text-base leading-relaxed md:mt-10">
                <p>
                    Most attendees stay in central Lisbon — Baixa, Chiado, Cais
                    do Sodré, or Alcântara — which are well connected to Belém and
                    close to the nightlife and restaurants. Belém itself is
                    quieter and more residential. You should book early, as late
                    September is a popular time to visit the city.
                </p>
                <h3 class="small-headline mt-8 mb-2" aria-label="Suggestions">
                    <span aria-hidden="true">//Suggestions</span>
                </h3>
                <details class="group border-b border-white/10 py-2" data-stay-entry="1">
                    <summary
                        class="grid cursor-pointer list-none grid-cols-[1fr_auto] items-start gap-4 text-base"
                    >
                        <span class="min-w-0 leading-snug">
                            <strong>The Emerald House Lisbon</strong>
                            <span class="font-mono text-xs text-muted">(1)</span>
                        </span>
                        <span
                            class="mt-1 font-mono text-xs text-faint transition group-open:rotate-45"
                        >
                            +
                        </span>
                    </summary>
                    <div class="mt-4 max-w-2xl space-y-4 text-base leading-relaxed text-muted">
                        <div>
                            <h4 class="font-mono text-xs uppercase text-faint">Brand</h4>
                            <p class="mt-1">The hotel is part of Curio Collection by Hilton.</p>
                        </div>
                        <div>
                            <h4 class="font-mono text-xs uppercase text-faint">Discount</h4>
                            <p class="mt-1">Lisbon AI attendees get <strong>15%</strong> on the Best Available Rate on the day of booking.</p>
                        </div>
                        <div>
                            <h4 class="font-mono text-xs uppercase text-faint">Book</h4>
                            <p class="mt-1">Email <a href="mailto:sales@emeraldhouse.pt" class="underline hover:text-cream">sales@emeraldhouse.pt</a> or <a href="mailto:sales2@emeraldhouse.pt" class="underline hover:text-cream">sales2@emeraldhouse.pt</a>.</p>
                        </div>
                        <div>
                            <h4 class="font-mono text-xs uppercase text-faint">Notes</h4>
                            <p class="mt-1">Mention that you are part of the Lisbon AI conference.</p>
                        </div>
                        <div>
                            <h4 class="font-mono text-xs uppercase text-faint">Map</h4>
                            <p class="mt-1"><a href="https://maps.app.goo.gl/s6AVZdFgA2iqqhVg9" target="_blank" rel="noopener noreferrer" class="underline hover:text-cream">View on Google Maps</a>.</p>
                        </div>
                    </div>
                </details>
                <details class="group border-b border-white/10 py-2" data-stay-entry="2">
                    <summary
                        class="grid cursor-pointer list-none grid-cols-[1fr_auto] items-start gap-4 text-base"
                    >
                        <span class="min-w-0 leading-snug">
                            <strong>Valverde Lisboa Hotel & Garden</strong>
                            <span class="font-mono text-xs text-muted">(2)</span>
                        </span>
                        <span
                            class="mt-1 font-mono text-xs text-faint transition group-open:rotate-45"
                        >
                            +
                        </span>
                    </summary>
                    <div class="mt-4 max-w-2xl space-y-4 text-base leading-relaxed text-muted">
                        <div>
                            <h4 class="font-mono text-xs uppercase text-faint">Group</h4>
                            <p class="mt-1">The hotel is part of Valverde Living.</p>
                        </div>
                        <div>
                            <h4 class="font-mono text-xs uppercase text-faint">Discount</h4>
                            <p class="mt-1">Lisbon AI attendees get <strong>15%</strong> on the Best Available Rate.</p>
                        </div>
                        <div>
                            <h4 class="font-mono text-xs uppercase text-faint">Book</h4>
                            <p class="mt-1">Email <a href="mailto:reservations.lisboa@valverdeliving.com" class="underline hover:text-cream">reservations.lisboa@valverdeliving.com</a>.</p>
                        </div>
                        <div>
                            <h4 class="font-mono text-xs uppercase text-faint">Valid</h4>
                            <p class="mt-1">Valid for stays around <strong>21–25 September 2026</strong>.</p>
