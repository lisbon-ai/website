---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const base = import.meta.env.BASE_URL;

const brailleFrames = ["⣾", "⣽", "⣻", "⢿", "⡿", "⣟", "⣯", "⣷"];
const randomBraille = () =>
  brailleFrames[Math.floor(Math.random() * brailleFrames.length)];

// Venue photos for the "getting there" column — one is picked at random on
// every page load by the client script below.
const venuePhotos = [1, 2, 3, 4].map(
  (n) => `${base}images/venue/${n}.jpg`,
);
const defaultPhoto = venuePhotos[0];
---

<Layout
    title="Tips for Attendees — Lisbon AI 2026"
    description="Practical tips for making the most of Lisbon AI 2026 — getting to the venue in Belém, where to stay, what to bring, and how to get around Lisbon."
>
    <Header />

    <!-- Intro -->
    <section class="border-t border-white/10">
        <div class="mx-auto grid max-w-[90rem] gap-12 px-6 py-20 md:grid-cols-2">
            <div>
                <div class="small-headline mb-4">/tips</div>
                <h1
                    class="font-display text-3xl font-bold uppercase tracking-tight mb-8"
                >
                    Tips for Attendees
                </h1>
                <p class="text-xl leading-relaxed">
                    Here are some tips and recommendations from our team to help
                    you organize and plan your trip to Lisbon AI.
                </p>
            </div>
            <div></div>
        </div>
    </section>

    <!-- Getting there -->
    <section class="border-t border-white/10">
        <div class="mx-auto grid max-w-[90rem] gap-12 px-6 py-16 md:grid-cols-2">
            <div>
                <h2 class="small-headline" aria-label="Getting there">
                    <span aria-hidden="true">/getting-there</span>
                </h2>
                <img
                    id="getting-there-photo"
                    src={defaultPhoto}
                    alt="Centro Champalimaud, the Lisbon AI venue"
                    class="mt-6 aspect-[3/2] w-full rounded-2xl border border-white/10 object-cover"
                />
            </div>
            <script define:vars={{ venuePhotos }}>
                const img = document.getElementById("getting-there-photo");
                if (img && venuePhotos.length) {
                    img.src =
                        venuePhotos[
                            Math.floor(Math.random() * venuePhotos.length)
                        ];
                }
            </script>
            <div class="text-base leading-relaxed md:mt-10">
                <p>
                    The venue is <strong>Centro Champalimaud</strong> on the
                    Belém waterfront, west of central Lisbon. Here's how to get
                    there:
                </p>
                <h3 class="small-headline mt-8 mb-2" aria-label="By car">
                    <span aria-hidden="true">//By car</span>
                </h3>
                <details class="group border-b border-white/10 py-2">
                    <summary
                        class="flex cursor-pointer list-none items-center justify-between text-base"
                    >
                        <span>
                            <span
                                class="mr-2 font-mono text-base text-muted md:text-lg"
                            >
                                {randomBraille()}
                            </span>
                            Paid parking inside the venue: €9.90 for a daily ticket
                        </span>
                        <span
                            class="font-mono text-xs text-faint transition group-open:rotate-45"
                        >
                            +
                        </span>
                    </summary>
                    <div class="mt-4 space-y-3 text-base leading-relaxed text-muted">
                        <img
                            src={`${base}images/getting-there/park-inside.jpg`}
                            alt="Map of the paid parking inside the Champalimaud venue"
                            class="w-full max-w-md rounded-lg border border-white/10"
                            loading="lazy"
                        />
                        <p>
                            <a
                                href="https://maps.app.goo.gl/1RWGU1mDKyCxrtrr6"
                                target="_blank"
                                rel="noopener noreferrer"
                                class="underline hover:text-cream"
                                >View on Google Maps</a
                            >
                        </p>
                    </div>
                </details>
                <details class="group border-b border-white/10 py-2">
                    <summary
                        class="flex cursor-pointer list-none items-center justify-between text-base"
                    >
                        <span>
                            <span
                                class="mr-2 font-mono text-base text-muted md:text-lg"
                            >
                                {randomBraille()}
                            </span>
                            Free parking outside the venue: fills up quickly
                        </span>
                        <span
                            class="font-mono text-xs text-faint transition group-open:rotate-45"
                        >
                            +
                        </span>
                    </summary>
                    <div class="mt-4 text-base leading-relaxed text-muted">
                        <img
                            src={`${base}images/getting-there/park-outside.jpg`}
                            alt="Map of free street parking near the venue along Avenida de Brasília"
                            class="w-full max-w-md rounded-lg border border-white/10"
                            loading="lazy"
                        />
                    </div>
                </details>
                <h3
                    class="small-headline mt-8 mb-2"
                    aria-label="By public transport"
                >
                    <span aria-hidden="true">//By public transport</span>
                </h3>
                <details class="group border-b border-white/10 py-2">
                    <summary
                        class="flex cursor-pointer list-none items-center justify-between text-base"
                    >
                        <span>
                            <span
                                class="mr-2 font-mono text-base text-muted md:text-lg"
                            >
                                {randomBraille()}
                            </span>
                            Tram, surface tram from Baixa toward Belém
                        </span>
                        <span
                            class="font-mono text-xs text-faint transition group-open:rotate-45"
                        >
                            +
                        </span>
                    </summary>
                    <div class="mt-4 space-y-3 text-base leading-relaxed text-muted">
                        <img
                            src={`${base}images/getting-there/tram.jpg`}
                            alt="Public transport routes from central Lisbon to the venue"
                            class="w-full max-w-md rounded-lg border border-white/10"
                            loading="lazy"
                        />
                        <p>
                            <a
                                href="https://maps.app.goo.gl/Ckc3FHLTfPZx3KEP7"
                                target="_blank"
                                rel="noopener noreferrer"
                                class="underline hover:text-cream"
                                >View on Google Maps</a
                            >
                        </p>
                    </div>
                </details>
                <details class="group border-b border-white/10 py-2">
                    <summary
                        class="flex cursor-pointer list-none items-center justify-between text-base"
                    >
                        <span>
                            <span
                                class="mr-2 font-mono text-base text-muted md:text-lg"
                            >
                                {randomBraille()}
                            </span>
                            Bus, several bus stops serve the area
                        </span>
                        <span
                            class="font-mono text-xs text-faint transition group-open:rotate-45"
                        >
                            +
                        </span>
                    </summary>
                    <div class="mt-4 text-base leading-relaxed text-muted">
                        <img
                            src={`${base}images/getting-there/bus-stops.jpg`}
                            alt="Map of bus stops around the venue in Pedrouços"
                            class="w-full max-w-md rounded-lg border border-white/10"
                            loading="lazy"
                        />
                    </div>
                </details>
                <details class="group border-b border-white/10 py-2">
                    <summary
                        class="flex cursor-pointer list-none items-center justify-between text-base"
                    >
                        <span>
                            <span
                                class="mr-2 font-mono text-base text-muted md:text-lg"
                            >
                                {randomBraille()}
                            </span>
                            Train, Estação Algés, a 13-minute walk (Cascais–Cais do
                            Sodré line)
                        </span>
                        <span
                            class="font-mono text-xs text-faint transition group-open:rotate-45"
                        >
                            +
                        </span>
                    </summary>
                    <div class="mt-4 space-y-3 text-base leading-relaxed text-muted">
                        <img
                            src={`${base}images/getting-there/walk.jpg`}
                            alt="Walking route from Estação Algés to the venue, about 13 minutes"
                            class="w-full max-w-md rounded-lg border border-white/10"
                            loading="lazy"
                        />
                        <p>
                            <a
                                href="https://maps.app.goo.gl/hfhbXUdR28gPdWmt5"
                                target="_blank"
                                rel="noopener noreferrer"
                                class="underline hover:text-cream"
                                >View on Google Maps</a
                            >
                        </p>
                    </div>
                </details>
                <h3 class="small-headline mt-8 mb-2" aria-label="Getting around">
                    <span aria-hidden="true">//Getting around</span>
                </h3>
                <p>
                    Once you're in Lisbon, the metro, trams, and buses are cheap
                    and reliable — grab a rechargeable Navegante / Viva Viagem
                    card at any station. Bolt and Uber are everywhere and
                    affordable. The centre is walkable, just expect hills and
                    cobblestones.
                </p>
            </div>
        </div>
    </section>

    <!-- Flying partner -->
    <section class="border-t border-white/10">
        <div class="mx-auto grid max-w-[90rem] gap-12 px-6 py-16 md:grid-cols-2">
            <div>
                <h2 class="small-headline" aria-label="Flying partner">
                    <span aria-hidden="true">/flying-partner</span>
                </h2>
                <img
                    src={`${base}images/logos/tap.svg`}
                    alt="TAP Air Portugal"
                    class="mt-6 h-6 w-auto"
                />
            </div>
            <div class="text-base leading-relaxed">
                <p>
                    <strong>TAP Air Portugal</strong> is our official flying
                    partner. Book directly on <a
                        href="https://www.flytap.com"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="underline hover:text-cream">flytap.com</a
                    > with the event code to get:
                </p>
                <ul class="mt-4 space-y-2 list-disc pl-6">
                    <li>
                        <strong>10% off</strong> Economy class (excluding Brand Discount
                        fares).
                    </li>
                    <li><strong>15% off</strong> Business class.</li>
                </ul>
                <p class="mt-4">
                    If you're a registered attendee, you can use codes <strong
                        >IT26TPCG68</strong
                    > and <strong>IT26TPCG68C</strong> to
                    get your discount.
                </p>
                <h3 class="small-headline mt-8 mb-2" aria-label="Conditions">
                    <span aria-hidden="true">//Conditions</span>
                </h3>
                <details class="group border-b border-white/10 py-2">
                    <summary
                        class="flex cursor-pointer list-none items-center justify-between text-base"
                    >
                        <span>
                            <span
                                class="mr-2 font-mono text-base text-muted md:text-lg"
                            >
                                {randomBraille()}
                            </span>
                            Full booking conditions
                        </span>
                        <span
                            class="font-mono text-xs text-faint transition group-open:rotate-45"
                        >
                            +
                        </span>
                    </summary>
                    <ul
                        class="mt-4 space-y-2 list-disc pl-6 text-base leading-relaxed text-muted"
                    >
                        <li>
                            The discount applies only to bookings made directly
                            on flytap.com — bookings through travel agencies or at
                            TAP counters do not qualify. Pay by credit card or
                            another method available on the website.
                        </li>
                        <li>
                            Valid on round trips from any TAP destination to
                            Lisbon, on TAP-operated flights only. Code-share
                            flights operated by other airlines, or flights on
                            other airlines, do not qualify.
                        </li>
                        <li>
                            You can book at any time, but travel dates must fall
                            within 10 days before and 10 days after the event, and
                            must include the event dates.
                        </li>
                        <li>
                            Not valid on resident, student, child, infant, senior,
                            or similar fares.
                        </li>
                        <li>
                            The event's specific code must be entered when booking
                            online to receive the discount.
                        </li>
                        <li>
                            Changes and refunds follow the rules of the fare you
                            choose, so consider a more flexible fare. Any permitted
                            change is made via <a
                                href="https://www.flytap.com"
                                target="_blank"
                                rel="noopener noreferrer"
                                class="underline hover:text-cream">flytap.com</a
                            > or the TAP contact center.
                        </li>
                    </ul>
                </details>
            </div>
        </div>
    </section>

    <!-- Where to stay -->
    <section class="border-t border-white/10">
        <div class="mx-auto grid max-w-[90rem] gap-12 px-6 py-16 md:grid-cols-2">
            <div>
                <h2 class="small-headline" aria-label="Where to stay">
                    <span aria-hidden="true">/where-to-stay</span>
                </h2>
            </div>
            <div class="text-base leading-relaxed">
                <p>
                    Most attendees stay in central Lisbon — Baixa, Chiado, Cais
                    do Sodré, or Alcântara — which are well connected to Belém and
                    close to the nightlife and restaurants. Belém itself is
                    quieter and more residential. You should book early, as late
                    September is a popular time to visit the city.
                </p>
                <h3 class="small-headline mt-8 mb-2" aria-label="Suggestions">
                    <span aria-hidden="true">//Suggestions</span>
                </h3>
                <details class="group border-b border-white/10 py-2">
                    <summary
                        class="flex cursor-pointer list-none items-center justify-between text-base"
                    >
                        <span>
                            <span
                                class="mr-2 font-mono text-base text-muted md:text-lg"
                            >
                                {randomBraille()}
                            </span>
                            <strong>The Emerald House Lisbon</strong>, Curio Collection by Hilton
                        </span>
                        <span
                            class="font-mono text-xs text-faint transition group-open:rotate-45"
                        >
                            +
                        </span>
                    </summary>
                    <p class="mt-4 max-w-2xl text-base leading-relaxed text-muted">
                        Lisbon AI attendees get a <strong>15% discount</strong> on
                        the Best Available Rate on the day of booking. To claim it,
                        email <a
                            href="mailto:sales@emeraldhouse.pt"
                            class="underline hover:text-cream"
                            >sales@emeraldhouse.pt</a
                        > or <a
                            href="mailto:sales2@emeraldhouse.pt"
                            class="underline hover:text-cream"
                            >sales2@emeraldhouse.pt</a
                        > and mention that you are part of the Lisbon AI congress.
                        <a
                            href="https://maps.app.goo.gl/s6AVZdFgA2iqqhVg9"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="underline hover:text-cream"
                            >View on Google Maps</a
                        >.
                    </p>
                </details>
                <details class="group border-b border-white/10 py-2">
                    <summary
                        class="flex cursor-pointer list-none items-center justify-between text-base"
                    >
                        <span>
                            <span
                                class="mr-2 font-mono text-base text-muted md:text-lg"
                            >
                                {randomBraille()}
                            </span>
                            <strong>Hotel Infante Santo</strong>, DH Hotels
                        </span>
                        <span
                            class="font-mono text-xs text-faint transition group-open:rotate-45"
                        >
                            +
                        </span>
                    </summary>
                    <p class="mt-4 max-w-2xl text-base leading-relaxed text-muted">
                        A comfortable base between the city centre and Belém. <a
                            href="https://maps.app.goo.gl/zCHsmxczGZ9mBUa56"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="underline hover:text-cream"
                            >View on Google Maps</a
                        >.
                    </p>
                </details>
                <details class="group border-b border-white/10 py-2">
                    <summary
                        class="flex cursor-pointer list-none items-center justify-between text-base"
                    >
                        <span>
                            <span
                                class="mr-2 font-mono text-base text-muted md:text-lg"
                            >
                                {randomBraille()}
                            </span>
                            <strong>Sublime Lisboa</strong>, Sublime Hotels
                        </span>
                        <span
                            class="font-mono text-xs text-faint transition group-open:rotate-45"
                        >
                            +
                        </span>
                    </summary>
                    <p class="mt-4 max-w-2xl text-base leading-relaxed text-muted">
                        A boutique hotel near Rato and Príncipe Real, within
                        walking distance of Chiado. Lisbon AI attendees get a <strong
                            >10% discount</strong
                        > when booking on <a
                            href="https://sublimelisboa.pt"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="underline hover:text-cream">sublimelisboa.pt</a
                        > with the code <strong>LISBONAI26</strong>. Kindly note it
                        is non-refundable and limited to availability and the categories
                        displayed. <a
                            href="https://maps.app.goo.gl/CDgQy6cQJhCNocWK6"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="underline hover:text-cream"
                            >View on Google Maps</a
                        >.
                    </p>
                </details>
                <details class="group border-b border-white/10 py-2">
                    <summary
                        class="flex cursor-pointer list-none items-center justify-between text-base"
                    >
                        <span>
                            <span
                                class="mr-2 font-mono text-base text-muted md:text-lg"
                            >
                                {randomBraille()}
                            </span>
                            <strong>DUO Hotel Lisbon</strong>, Curio Collection by
                            Hilton
                        </span>
                        <span
                            class="font-mono text-xs text-faint transition group-open:rotate-45"
                        >
                            +
                        </span>
                    </summary>
                    <p class="mt-4 max-w-2xl text-base leading-relaxed text-muted">
                        On Rua Dom Luís I in Cais do Sodré, a few minutes from the
                        Time Out Market and the riverside, with direct trains to
                        Belém from Cais do Sodré station. Book through the <a
                            href="https://eventsathilton.com/show/6a6086a4b244e43f9419ff06"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="underline hover:text-cream"
                            >Lisbon AI booking page</a
                        >. <a
                            href="https://www.hilton.com/en/hotels/lisboqq-duo-hotel-lisbon/hotel-location/"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="underline hover:text-cream">See the location</a
                        >.
                    </p>
                </details>
                <details class="group border-b border-white/10 py-2">
                    <summary
                        class="flex cursor-pointer list-none items-center justify-between text-base"
                    >
                        <span>
                            <span
                                class="mr-2 font-mono text-base text-muted md:text-lg"
                            >
                                {randomBraille()}
                            </span>
                            <strong
                                >Art Legacy Hotel, My Story Hotel Tejo &amp; My Story
                                Hotel Figueira</strong
                            >, My Story Hotels
                        </span>
                        <span
                            class="font-mono text-xs text-faint transition group-open:rotate-45"
                        >
                            +
                        </span>
                    </summary>
                    <p class="mt-4 max-w-2xl text-base leading-relaxed text-muted">
                        Lisbon AI attendees get a <strong>10% discount</strong> on
                        direct reservations. Email <a
                            href="mailto:corporate@mystoryhotels.com"
                            class="underline hover:text-cream"
                            >corporate@mystoryhotels.com</a
                        > and mention that you are attending the Lisbon AI event, and
                        they will send you a proposal with the discount applied. <a
                            href="https://www.mystoryhotels.com/en/"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="underline hover:text-cream"
                            >mystoryhotels.com</a
                        >.
                    </p>
                </details>
                <details class="group border-b border-white/10 py-2">
                    <summary
                        class="flex cursor-pointer list-none items-center justify-between text-base"
                    >
                        <span>
                            <span
                                class="mr-2 font-mono text-base text-muted md:text-lg"
                            >
                                {randomBraille()}
                            </span>
                            <strong>Mama Shelter Lisboa</strong>
                        </span>
                        <span
                            class="font-mono text-xs text-faint transition group-open:rotate-45"
                        >
                            +
                        </span>
                    </summary>
                    <p class="mt-4 max-w-2xl text-base leading-relaxed text-muted">
                        Lisbon AI attendees get <strong>10% off</strong> the Best Non-Refundable
                        Rate with the promocode <strong>LISBONAI2026</strong>, valid
                        for stays from <strong>21 to 25 September</strong> on Small and
                        Medium rooms. Nights before or after those dates are not discounted,
                        the code cannot be combined with other promotions, and requests
                        must be made by <strong>31 August</strong>. To book, email <a
                            href="mailto:lisboa@mamashelter.com"
                            class="underline hover:text-cream"
                            >lisboa@mamashelter.com</a
                        > with the subject &ldquo;Promocode LISBONAI2026&rdquo; and your
                        stay details — reservations made through the Mama Shelter website
                        or a travel agency cannot receive the discount.
                    </p>
                </details>
                <details class="group border-b border-white/10 py-2">
                    <summary
                        class="flex cursor-pointer list-none items-center justify-between text-base"
                    >
                        <span>
                            <span
                                class="mr-2 font-mono text-base text-muted md:text-lg"
                            >
                                {randomBraille()}
                            </span>
                            <strong>Lisboa Pessoa Hotel</strong>, Art Soul Group
                        </span>
                        <span
                            class="font-mono text-xs text-faint transition group-open:rotate-45"
                        >
                            +
                        </span>
                    </summary>
                    <p class="mt-4 max-w-2xl text-base leading-relaxed text-muted">
                        Lisbon AI attendees get an <strong>11% discount</strong> on rooms
                        booked at <a
                            href="https://www.artsoulgroup.com/lisboapessoahotel/en/"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="underline hover:text-cream"
                            >artsoulgroup.com</a
                        > with the promocode <strong>WEDPROMO11</strong>. Valid for stays
                        from <strong>22 to 25 September 2026</strong>. It is not cumulative
                        with other current promotions, including the Guestclub rate. A
                        deposit of 50% of the total is required 30 days before arrival
                        to guarantee the reservation, with free cancellation until that
                        date; the balance is due 7 days before arrival. Cancellations
                        outside these deadlines and no-shows incur a 100% fee. These
                        terms cover a total of 15 rooms — beyond that, the first deposit
                        moves to 90 or 120 days before arrival depending on the number
                        of rooms booked.
                    </p>
                </details>
                <details class="group border-b border-white/10 py-2">
                    <summary
                        class="flex cursor-pointer list-none items-center justify-between text-base"
                    >
                        <span>
                            <span
                                class="mr-2 font-mono text-base text-muted md:text-lg"
                            >
                                {randomBraille()}
                            </span>
                            <strong>Jupiter Lisboa Hotel</strong>, Rooftop &amp; Spa
                        </span>
                        <span
                            class="font-mono text-xs text-faint transition group-open:rotate-45"
                        >
                            +
                        </span>
                    </summary>
                    <p class="mt-4 max-w-2xl text-base leading-relaxed text-muted">
                        Lisbon AI attendees get a <strong>10% discount</strong> on all
                        online bookings made on the hotel&rsquo;s official website with
                        the promocode <strong>LISBONAI2026</strong>. Valid for stays
                        between <strong>18 and 28 September 2026</strong>. <a
                            href="https://www.jupiterlisboahotel.com/"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="underline hover:text-cream"
                            >jupiterlisboahotel.com</a
                        >.
                    </p>
                </details>
            </div>
        </div>
    </section>

    <!-- What to see & eat -->
    <section class="border-t border-white/10">
        <div class="mx-auto grid max-w-[90rem] gap-12 px-6 py-16 md:grid-cols-2">
            <div>
                <h2 class="small-headline" aria-label="What to see and eat">
                    <span aria-hidden="true">/what-to-see-&amp;-eat</span>
                </h2>
                <div id="see-gallery" class="mt-6 flex flex-wrap gap-2">
                    {[
                        { src: "belem", alt: "Torre de Belém", w: "w-48" },
                        { src: "jeronimos", alt: "Mosteiro dos Jerónimos", w: "w-32" },
                        { src: "padrao", alt: "Padrão dos Descobrimentos", w: "w-32" },
                        { src: "palacio-belem", alt: "Palácio Nacional de Belém", w: "w-48" },
