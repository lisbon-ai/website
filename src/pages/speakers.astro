---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

import { speakers as allSpeakers, hasCard, logoHeight, talkAnchor } from "../data/speakers";
import { days } from "../data/schedule";

// Topic and day both come from the schedule slot a speaker sits in, which is
// also what /talks is built from. So a speaker with no slot has neither a
// session line nor an entry to link to: their title still shows, unlinked.
const sessionByName = new Map(
  days.flatMap((day) =>
    day.slots.flatMap((slot) =>
      (slot.speakers ?? []).map(
        (name) => [name, `${slot.title}, ${day.label}`],
      ),
    ),
  ),
);

// Only speakers whose photo and bio have landed get a card; the rest exist for
// the schedule until then.
const speakers = allSpeakers.filter(hasCard);

// Vary the texture crop per card so no two cards show the same region.
const texturePositions = [
  "0% 0%",
  "100% 0%",
  "50% 20%",
  "0% 100%",
  "100% 60%",
  "25% 80%",
  "80% 100%",
];
---

<Layout
  title="Speakers — Lisbon AI 2026"
  description="Meet the builders, researchers, and engineers speaking at Lisbon AI 2026."
>
  <Header />

  <main>
    <!-- Speakers -->
    <section class="border-t border-white/10">
      <div class="mx-auto max-w-[90rem] py-16">
        <div class="small-headline mb-4 px-6">/speakers</div>
        <h1 class="font-display text-3xl font-bold uppercase tracking-tight mb-8 px-6">All the speakers</h1>

        <div class="px-3 md:px-6">
          <div class="grid gap-0 border-x border-white/10 md:grid-cols-2">
            {
              speakers.map(({ name, org, role, profileUrl, orgUrl, logo, image, bio, talk }, i) => (
                <div
                  class:list={[
                    "speaker-texture relative isolate flex flex-col items-start gap-3 border-b border-white/10 p-8 text-xl md:p-12 md:text-2xl",
                    { "md:border-l md:border-white/10": i % 2 === 1 },
                    { "border-t border-white/10": i === 0 },
                    { "md:border-t md:border-white/10": i === 1 },
                  ]}
                  style={`--tex-pos: ${texturePositions[i % texturePositions.length]}`}
                >
                  <figure class="mb-6 flex h-[200px] w-full items-center justify-center overflow-hidden rounded-2xl">
                    <img
                      src={`${import.meta.env.BASE_URL}images/speakers/${image}`}
                      alt={name}
                      class="h-[200px] w-[200px] rounded-2xl object-cover"
                    />
                  </figure>
                  <div class="flex w-full items-center justify-between gap-3">
                    <div class="flex flex-col items-start gap-1">
                      <h3>
                        {profileUrl ? (
                          <a href={profileUrl} class="hover:text-muted">
                            {name}
                          </a>
                        ) : (
                          name
                        )}
                      </h3>
                      <span class="font-mono text-xs text-faint">
                        {orgUrl ? (
                          <a href={orgUrl} class="hover:text-muted">
                            //{[role, org].filter(Boolean).join(", ")}
                          </a>
                        ) : (
                          <>//{[role, org].filter(Boolean).join(", ")}</>
                        )}
                      </span>
                    </div>
                    {logo && (orgUrl ? (
                      <a
                        href={orgUrl}
                        class="logo-tint shrink-0"
                        style={`--logo: url("${import.meta.env.BASE_URL}images/logos/${logo}")`}
                      >
                        <img
                          src={`${import.meta.env.BASE_URL}images/logos/${logo}`}
                          alt={org}
                          class:list={["w-auto", logoHeight(logo)]}
                        />
                      </a>
                    ) : (
                      <span
                        class="logo-tint shrink-0"
                        style={`--logo: url("${import.meta.env.BASE_URL}images/logos/${logo}")`}
                      >
                        <img
                          src={`${import.meta.env.BASE_URL}images/logos/${logo}`}
                          alt={org}
                          class:list={["w-auto", logoHeight(logo)]}
                        />
                      </span>
                    ))}
                  </div>
                  {bio && (
                    <p class="mt-2 text-base leading-relaxed text-muted">
                      {bio}
                    </p>
                  )}
                  {talk && (
                    <div class="mt-2 w-full border-t border-white/10 pt-4">
                      {/* Links through to the full abstract on /talks, the same
                          target the schedule uses. */}
                      <div class="text-base leading-snug text-balance text-muted">
                        {sessionByName.has(name) ? (
                          <a
                            href={`${import.meta.env.BASE_URL}talks/#${talkAnchor(name)}`}
                            class="hover:text-cream"
                          >
                            {talk}
                          </a>
                        ) : (
                          talk
                        )}
                      </div>
                      {sessionByName.has(name) && (
                        <p class="mt-1 font-mono text-xs text-faint">
                          {sessionByName.get(name)}
                        </p>
                      )}
                    </div>
                  )}
                </div>
              ))
            }
            <div
              class:list={[
                "flex flex-col items-center justify-center gap-2 border-b border-white/10 p-8 text-center md:p-12",
                { "md:col-span-2": speakers.length % 2 === 0 },
                { "md:border-l md:border-white/10": speakers.length % 2 === 1 },
              ]}
            >
              <p class="text-lg leading-snug md:text-xl">
                More speakers landing every few days.
              </p>
              <p class="font-mono text-xs text-faint">
                Keep an eye on this space
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
